// Jenkinsfile.sentry — build the kernel sentry module for every Ubuntu 24.04
// kernel and publish it to https://dl.bromure.io/sentry/ (bucket bromure-dl).
//
// Why a CDN and a daily job: the sentry is an out-of-tree kernel module, and a
// module loads only into the exact kernel it was built for. Ubuntu ships a new
// kernel ABI (6.8.0-NNN) every few weeks, a workspace can `apt upgrade` into
// one at any time, and new base images pick them up. Bundling modules in the
// app would always lag. Instead this job builds every kernel the archive
// offers, the app downloads the ones a workspace needs, and the guest waits a
// few seconds for the host to fetch a module it hasn't seen yet.
//
// Modules are published per module SOURCE (sourceHash, see
// scripts/openshell-guest/sentry/source-hash.sh): the app only loads a module
// built from the source it ships. Each run builds for this checkout's source
// and for the source of the last RELEASES release tags, so shipped app
// versions keep getting modules for new kernels too.
//
// Modules are built for both guest arches: arm64 (the Mac's guests) under
// sentry/<hash>/, amd64 (Linux/KVM hosts' guests) under sentry/<hash>/amd64/.
//
// Everything runs in containers, each arch natively: arm64 on kube-builder-a
// (Docker-in-Docker, so no bind mounts: inputs go in via `docker build`,
// results out via `docker cp`), amd64 on linux-kvm-amd64 (same way; its
// inputs and outputs travel by stash). Publishing is on kube-builder-a.
//   1. Build container (scripts/openshell-guest/sentry/Dockerfile, ubuntu:24.04)
//      per source and arch: fetch that source's published catalog, build every
//      missing kernel with build.sh --verify (two builds must be byte-identical).
//   2. Publish container (node): sign the merged catalog with the Sparkle key,
//      upload modules then catalog, smoke-test from the CDN.
// Publishing is additive; nothing is ever deleted.
pipeline {
    agent { label 'kube-builder-a' }

    triggers {
        // Daily: new kernel ABIs reach users through `apt upgrade` and new base
        // images; the module should already be on the CDN when they do.
        cron('H 4 * * *')
    }

    options {
        // Each kernel is a headers install + two builds (~2–4 min); MAX_BUILDS
        // caps a run, and a first run over the whole archive spreads over days.
        timeout(time: 3, unit: 'HOURS')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '60'))
    }

    // A blank string parameter (or any parameter on the run that first
    // registers them) isn't set in the environment at all, and the steps run
    // under `set -u`: each one is read with its default.
    parameters {
        booleanParam(name: 'DRY_RUN', defaultValue: false,
            description: 'Build and sign, but upload nothing.')
        string(name: 'RELEASES', defaultValue: '3',
            description: 'Also build for the module source of the last N agentic-coding-v* release tags.')
        string(name: 'MAX_BUILDS', defaultValue: '12',
            description: 'Most kernels to build per source per run (newest first).')
        string(name: 'FORCE_KERNELS', defaultValue: '',
            description: 'Space-separated kernels to rebuild even if published, e.g. 6.8.0-142-generic.')
        string(name: 'KERNEL_PATTERN', defaultValue: '^linux-headers-6\\.8\\.0-[0-9]+-generic$',
            description: 'ERE over linux-headers package names to build for.')
        // Built on the x86_64 agent (linux-kvm-amd64). The amd64 catalog is a
        // catalog of its own, sentry/<hash>/amd64/catalog.json, whose module
        // statements name the arch (see the Build modules and Publish stages).
        booleanParam(name: 'BUILD_AMD64', defaultValue: true,
            description: 'Also build and publish amd64 modules (Linux/KVM hosts), to sentry/<hash>/amd64/.')
    }

    environment {
        DO_SPACES_ENDPOINT    = 'https://nyc3.digitaloceanspaces.com'
        DO_SPACES_REGION      = 'nyc3'
        DO_SPACES_BUCKET      = 'bromure-dl'
        DO_SPACES_PUBLIC_BASE = 'https://dl.bromure.io'
        SENTRY_DIR            = 'scripts/openshell-guest/sentry'
    }

    stages {
        stage('Docker client') {
            steps {
                // The pod's docker CLI (API 1.42) is older than the DinD daemon
                // accepts (1.44+): "client version 1.42 is too old". Fetch the
                // latest stable static client instead of pinning one; every
                // docker step below puts it first on PATH.
                sh '''
                    set -eu
                    case "$(uname -m)" in
                        aarch64|arm64) arch=aarch64 ;;
                        x86_64|amd64)  arch=x86_64 ;;
                        *) echo "unsupported arch $(uname -m)"; exit 1 ;;
                    esac
                    base="https://download.docker.com/linux/static/stable/$arch"
                    ver=$(curl -fsSL "$base/" | grep -o 'docker-[0-9][0-9.]*\\.tgz' \
                          | sed 's/^docker-//; s/\\.tgz$//' | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)
                    [ -n "$ver" ] || { echo "no docker release found at $base"; exit 1; }
                    rm -rf .docker-cli && mkdir -p .docker-cli
                    curl -fsSL "$base/docker-$ver.tgz" | tar -xz -C .docker-cli --strip-components=1 docker/docker
                    # BuildKit for `docker build` (the static tarball has no plugins);
                    # without it the client falls back to the legacy builder.
                    bx=$(curl -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/docker/buildx/releases/latest | sed 's#.*/tag/##') || bx=""
                    if [ -n "$bx" ]; then
                        mkdir -p .docker-cli/config/cli-plugins
                        bxarch=$([ "$arch" = aarch64 ] && echo arm64 || echo amd64)
                        curl -fsSL -o .docker-cli/config/cli-plugins/docker-buildx \
                            "https://github.com/docker/buildx/releases/download/$bx/buildx-$bx.linux-$bxarch" \
                            && chmod +x .docker-cli/config/cli-plugins/docker-buildx || echo "buildx not installed; legacy builder"
                    fi
                    PATH="$PWD/.docker-cli:$PATH" DOCKER_CONFIG="$PWD/.docker-cli/config" docker version --format 'client {{.Client.Version}} (API {{.Client.APIVersion}}) · daemon {{.Server.Version}} (API {{.Server.APIVersion}})'
                '''
            }
        }

        stage('Pick sources') {
            steps {
                // Release tags pick the older sources to build for. The SCM
                // credential is only bound during Checkout SCM, so bind the same
                // deploy key for this fetch; kube-builder-a is an ephemeral
                // pod with no known_hosts, hence accept-new.
                withCredentials([sshUserPrivateKey(
                    credentialsId: '993ae120-54c2-45af-bdd0-2303d982cac7',
                    keyFileVariable: 'SSH_KEY')]) {
                    sh '''
                        set -eu
                        export GIT_SSH_COMMAND="ssh -i $SSH_KEY -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
                        git fetch --tags --force --quiet origin
                    '''
                }
                sh '''
                    set -eu
                    n_tags=$(git tag -l 'agentic-coding-v*' | wc -l)
                    [ "$n_tags" -gt 0 ] || echo "WARNING: no release tags visible; building for this checkout's source only"
                    rm -rf sentry-ci && mkdir -p sentry-ci
                    : > sentry-ci/sources
                    add_source() {   # ref label
                        ctx="sentry-ci/ctx-$2"
                        mkdir -p "$ctx"
                        for f in Makefile bromure_sentry.c bromure_sentry.h; do
                            git show "$1:$SENTRY_DIR/$f" > "$ctx/$f" 2>/dev/null || { rm -rf "$ctx"; return 0; }
                        done
                        # Always this checkout's scripts; only the module source varies.
                        for f in Dockerfile build.sh ci-build.sh source-hash.sh; do cp "$SENTRY_DIR/$f" "$ctx/"; done
                        h=$(sh "$SENTRY_DIR/source-hash.sh" "$ctx")
                        if grep -q " $h$" sentry-ci/sources; then rm -rf "$ctx"; return 0; fi
                        epoch=$(git log -1 --format=%ct "$1" -- "$SENTRY_DIR")
                        echo "$2 $epoch $h" >> sentry-ci/sources
                        echo "source $2 ($1) → $h"
                    }
                    add_source HEAD head
                    n=0
                    for t in $(git tag -l 'agentic-coding-v*' --sort=-v:refname); do
                        [ "$n" -ge "${RELEASES:-3}" ] && break
                        n=$((n + 1))
                        add_source "$t" "$(printf '%s' "$t" | tr -c 'A-Za-z0-9.' '-')"
                    done
                    cat sentry-ci/sources
                '''
                // The amd64 build runs on another agent: it takes the same contexts.
                stash name: 'sentry-ctx', includes: 'sentry-ci/sources, sentry-ci/ctx-*/**'
            }
        }

        stage('Build modules') {
            parallel {
                stage('arm64') {
                    steps {
                        sh '''
                            set -eu
                            export PATH="$WORKSPACE/.docker-cli:$PATH" DOCKER_CONFIG="$WORKSPACE/.docker-cli/config"
                            while read -r label epoch hash; do
                                echo "=== building for source $label ($hash) ==="
                                docker rm -f "sentry-$label" 2>/dev/null || true
                                docker build --pull --platform linux/arm64 -q \
                                    -t "bromure-sentry-builder:$label" "sentry-ci/ctx-$label"
                                # A failed kernel is recorded in manifest.json, not fatal;
                                # only an infrastructure failure stops the run.
                                docker run --platform linux/arm64 --name "sentry-$label" \
                                    -e SOURCE_DATE_EPOCH="$epoch" -e PUBLIC_BASE="$DO_SPACES_PUBLIC_BASE" \
                                    -e MAX_BUILDS="${MAX_BUILDS:-12}" -e FORCE_KERNELS="${FORCE_KERNELS:-}" \
                                    -e KERNEL_PATTERN="${KERNEL_PATTERN:-^linux-headers-6\\.8\\.0-[0-9]+-generic$}" \
                                    "bromure-sentry-builder:$label"
                                docker cp "sentry-$label:/out" "sentry-ci/out-$label"
                                docker rm "sentry-$label"
                            done < sentry-ci/sources
                        '''
                    }
                }
                // amd64 (the Linux/KVM host's guests), natively on the x86_64
                // agent: same source, same Dockerfile and ci-build.sh, which
                // reads the arch from dpkg, looks up sentry/<hash>/amd64/
                // catalog.json and records "arch": "amd64" in its manifest. Its
                // out dirs come back by stash into sentry-ci/amd64/, OUT of
                // sentry-ci/out-* (the arm64 tree the Publish gate reads): kernel
                // names are the same on both arches (6.8.0-NNN-generic), so amd64
                // modules are a catalog of their own.
                //
                // Not a stage-level agent: that agent also runs the amd64 image
                // job (hours), and a stage that times out waiting for it would
                // fail the run and skip the arm64 publish. Here a busy, offline
                // or failing amd64 side only marks the run UNSTABLE.
                stage('amd64') {
                    when { expression { params.BUILD_AMD64 != false } }
                    steps {
                        script {
                            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                                timeout(time: 150, unit: 'MINUTES') {
                                    node('linux-kvm-amd64') {
                                        try {
                                            sh 'rm -rf sentry-ci'
                                            unstash 'sentry-ctx'
                                            sh '''
                                                set -eu
                                                [ "$(uname -m)" = x86_64 ] || { echo "amd64 modules build natively: an x86_64 agent, not $(uname -m)"; exit 1; }
                                                mkdir -p sentry-ci/amd64
                                                while read -r label epoch hash; do
                                                    # A release from before the module knew x86_64
                                                    # stops at its #error for every kernel, each run.
                                                    if ! grep -q 'defined(CONFIG_X86_64)' "sentry-ci/ctx-$label/bromure_sentry.c"; then
                                                        echo "=== source $label ($hash) is arm64-only: no amd64 build ==="
                                                        continue
                                                    fi
                                                    echo "=== building amd64 for source $label ($hash) ==="
                                                    docker rm -f "sentry-amd64-$label" 2>/dev/null || true
                                                    docker build --pull --platform linux/amd64 -q \
                                                        -t "bromure-sentry-builder:amd64-$label" "sentry-ci/ctx-$label"
                                                    docker run --platform linux/amd64 --name "sentry-amd64-$label" \
                                                        -e SOURCE_DATE_EPOCH="$epoch" -e PUBLIC_BASE="$DO_SPACES_PUBLIC_BASE" \
                                                        -e MAX_BUILDS="${MAX_BUILDS:-12}" -e FORCE_KERNELS="${FORCE_KERNELS:-}" \
                                                        -e KERNEL_PATTERN="${KERNEL_PATTERN:-^linux-headers-6\\.8\\.0-[0-9]+-generic$}" \
                                                        "bromure-sentry-builder:amd64-$label"
                                                    docker cp "sentry-amd64-$label:/out" "sentry-ci/amd64/out-$label"
                                                    docker rm "sentry-amd64-$label"
                                                done < sentry-ci/sources
                                            '''
                                            stash name: 'sentry-amd64-out', includes: 'sentry-ci/amd64/**', allowEmpty: true
                                        } finally {
                                            sh '''
                                                for c in $(docker ps -aq --filter name=sentry-amd64-); do docker rm -f "$c"; done 2>/dev/null || true
                                                docker image ls -q 'bromure-sentry-builder' | xargs -r docker rmi -f 2>/dev/null || true
                                                rm -rf sentry-ci
                                            '''
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Publish') {
            steps {
                withCredentials([
                    string(credentialsId: 'DO_SPACES_KEY',       variable: 'DO_SPACES_KEY'),
                    string(credentialsId: 'DO_SPACES_SECRET',    variable: 'DO_SPACES_SECRET'),
                    // Same ed25519 key that signs Sparkle updates and the image
                    // catalogs; the app verifies against SUPublicEDKey.
                    string(credentialsId: 'SPARKLE_PRIVATE_KEY', variable: 'SPARKLE_PRIVATE_KEY')
                ]) {
                    sh '''
                        set -eu
                        export PATH="$WORKSPACE/.docker-cli:$PATH" DOCKER_CONFIG="$WORKSPACE/.docker-cli/config"
                        # Most days no new kernel has shipped and every source's
                        # catalog is complete: nothing to sign or upload, so skip
                        # building the publisher image (and its npm install).
                        # Unless a published catalog no longer verifies (a bucket
                        # write stripped its module signatures: the app refuses it
                        # whole) — then publish-sentry-modules.sh republishes it.
                        # make-sentry-catalog.mjs needs only node builtins, so a
                        # bare node image checks it; files go in by tar (no mounts
                        # on this daemon, as docker cp above).
                        if ! grep -L '"built": \\[\\]' sentry-ci/out-*/manifest.json | grep -q .; then
                            pub=$(sed -n 's/.*SENTRY_CATALOG_PUBLIC_KEY:-\\([^}]*\\)}.*/\\1/p' scripts/publish-sentry-modules.sh)
                            if tar -cf - tools/make-sentry-catalog.mjs $(ls sentry-ci/out-*/previous-catalog.json 2>/dev/null) \\
                                | docker run -i --rm -e PUB="$pub" node:22-bookworm-slim sh -euc '
                                    mkdir -p /w/empty && cd /w && tar -xf -
                                    for c in sentry-ci/out-*/previous-catalog.json; do
                                        [ -f "$c" ] || continue
                                        h=$(node -e "console.log(JSON.parse(require(\\"fs\\").readFileSync(process.argv[1])).sourceHash)" "$c")
                                        node tools/make-sentry-catalog.mjs --verify "$c" --source-hash "$h" \\
                                            --modules /w/empty --public-key "$PUB" || exit 1
                                    done'; then
                                echo "No new modules for any source: nothing to publish."
                                exit 0
                            fi
                            echo "A published catalog fails verification: republishing."
                        fi
                        # The publisher image: node + the release tools (socket.dev-
                        # wrapped install, like the other pipelines) + this run's outputs.
                        rm -rf sentry-ci/pub && mkdir -p sentry-ci/pub/tools sentry-ci/pub/scripts
                        cp tools/package.json tools/package-lock.json tools/spaces-put.mjs \
                           tools/make-sentry-catalog.mjs sentry-ci/pub/tools/
                        cp scripts/publish-sentry-modules.sh sentry-ci/pub/scripts/
                        cp -R sentry-ci/out-* sentry-ci/pub/
                        cat > sentry-ci/pub/Dockerfile <<'EOF'
FROM node:22-bookworm-slim
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends curl ca-certificates \\
 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY tools/package.json tools/package-lock.json tools/
RUN cd tools && (npx --yes @socketsecurity/cli npm ci --silent \\
                 || npx --yes @socketsecurity/cli npm install --silent)
COPY . .
EOF
                        docker build -q -t bromure-sentry-publisher sentry-ci/pub
                        while read -r label epoch hash; do
                            docker run --rm \
                                -e DO_SPACES_KEY -e DO_SPACES_SECRET -e SPARKLE_PRIVATE_KEY \
                                -e DO_SPACES_ENDPOINT -e DO_SPACES_REGION -e DO_SPACES_BUCKET \
                                -e DO_SPACES_PUBLIC_BASE -e DRY_RUN="${DRY_RUN:-false}" -e SENTRY_EXPECT_ARCH=arm64 \
                                bromure-sentry-publisher ./scripts/publish-sentry-modules.sh "out-$label"
                        done < sentry-ci/sources
                    '''
                    // amd64 (BUILD_AMD64): its own catalog, sentry/<hash>/amd64/,
                    // each out dir's manifest naming the arch for the publish
                    // script (which skips an out dir with nothing new whose
                    // published catalog still verifies). A step of its own, after
                    // the arm64 one: that step's gate ends it early on a day
                    // arm64 has nothing new.
                    script {
                        if (params.BUILD_AMD64 != false) {
                            // Absent when the amd64 build didn't run or failed
                            // (the run is UNSTABLE already): nothing to publish.
                            def got = true
                            try { unstash 'sentry-amd64-out' } catch (e) { got = false; echo "No amd64 outputs: ${e.message}" }
                            if (got) {
                                sh '''
                                    set -eu
                                    export PATH="$WORKSPACE/.docker-cli:$PATH" DOCKER_CONFIG="$WORKSPACE/.docker-cli/config"
                                    ls -d sentry-ci/amd64/out-* >/dev/null 2>&1 || { echo "No amd64 outputs."; exit 0; }
                                    rm -rf sentry-ci/pub-amd64
                                    mkdir -p sentry-ci/pub-amd64/tools sentry-ci/pub-amd64/scripts sentry-ci/pub-amd64/amd64
                                    cp tools/package.json tools/package-lock.json tools/spaces-put.mjs \
                                       tools/make-sentry-catalog.mjs sentry-ci/pub-amd64/tools/
                                    cp scripts/publish-sentry-modules.sh sentry-ci/pub-amd64/scripts/
                                    cp -R sentry-ci/amd64/out-* sentry-ci/pub-amd64/amd64/
                                    # The arm64 step's publisher Dockerfile, when it got that far;
                                    # else the same one, written here.
                                    printf '%s\n' \
                                        'FROM node:22-bookworm-slim' \
                                        'RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*' \
                                        'WORKDIR /work' \
                                        'COPY tools/package.json tools/package-lock.json tools/' \
                                        'RUN cd tools && (npx --yes @socketsecurity/cli npm ci --silent || npx --yes @socketsecurity/cli npm install --silent)' \
                                        'COPY . .' > sentry-ci/pub-amd64/Dockerfile
                                    docker build -q -t bromure-sentry-publisher-amd64 sentry-ci/pub-amd64
                                    for out in sentry-ci/amd64/out-*; do
                                        docker run --rm \
                                            -e DO_SPACES_KEY -e DO_SPACES_SECRET -e SPARKLE_PRIVATE_KEY \
                                            -e DO_SPACES_ENDPOINT -e DO_SPACES_REGION -e DO_SPACES_BUCKET \
                                            -e DO_SPACES_PUBLIC_BASE -e DRY_RUN="${DRY_RUN:-false}" -e SENTRY_EXPECT_ARCH=amd64 \
                                            bromure-sentry-publisher-amd64 ./scripts/publish-sentry-modules.sh "amd64/$(basename "$out")"
                                    done
                                '''
                            }
                        }
                    }
                }
            }
        }

        stage('Report') {
            steps {
                script {
                    // Kernels that failed to build don't stop the publish of the
                    // rest, but they mark the run UNSTABLE so someone looks.
                    def failed = sh(returnStdout: true, script: '''
                        cat sentry-ci/out-*/manifest.json sentry-ci/amd64/out-*/manifest.json 2>/dev/null \
                          | grep -o '"failed": \\[[^]]*\\]' | grep -v '\\[\\]' || true
                    ''').trim()
                    if (failed) {
                        echo "Kernels that failed to build: ${failed}"
                        currentBuild.result = 'UNSTABLE'
                    }
                }
                archiveArtifacts artifacts: 'sentry-ci/out-*/manifest.json, sentry-ci/out-*/catalog.json, sentry-ci/out-*/modules/*.txt, sentry-ci/amd64/out-*/manifest.json, sentry-ci/amd64/out-*/catalog.json, sentry-ci/amd64/out-*/modules/*.txt',
                                 allowEmptyArchive: true
            }
        }
    }

    post {
        always {
            sh '''
                export PATH="$WORKSPACE/.docker-cli:$PATH" DOCKER_CONFIG="$WORKSPACE/.docker-cli/config"
                for c in $(docker ps -aq --filter name=sentry-); do docker rm -f "$c"; done 2>/dev/null || true
                docker image ls -q 'bromure-sentry-*' | xargs -r docker rmi -f 2>/dev/null || true
            '''
        }
    }
}
