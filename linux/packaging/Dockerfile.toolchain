# The Debian package's build environment (Jenkinsfile.linux): Swift, Rust
# and, when the target architecture isn't the builder's, the cross pieces.
# Built for the BUILDER's platform (kube-builder-b: arm64); nothing runs
# under emulation.
#
#   TARGET_ARCH=x86_64 on an arm64 builder (the default case):
#     - a Swift SDK for x86_64-unknown-linux-gnu (Ubuntu 24.04), made by
#       swift-sdk-generator for this image's exact Swift version, with the
#       libraries bromure-ac links that the generator leaves out (zlib,
#       libbrotlidec) added to its sysroot;
#     - for Firecracker: Ubuntu's x86_64 cross gcc (gcc-x86-64-linux-gnu)
#       with x86_64 musl (multiarch musl-dev:amd64) behind an
#       x86_64-linux-musl-gcc wrapper (musl-gcc's own recipe: the gcc and
#       musl's specs file), and the amd64 kernel UAPI headers
#       (linux-libc-dev:amd64). All of it runs on the builder: musl.cc's
#       cross toolchains are x86_64-hosted.
#     - for virtiofsd and passt (linux/virtiofsd, linux/passt): the same
#       cross gcc with the target's glibc (libc6-dev-amd64-cross: its crt
#       files and libc.a; --no-install-recommends leaves it out), and
#       the target's libseccomp-dev and libcap-ng-dev packages (their
#       static libraries), kept in /opt/target-debs with zlib's and brotli's;
#     - for libcurl (linux/curl): the target's OpenSSL, nghttp2 and zstd
#       packages (headers and libraries), in /opt/target-debs too.
#   TARGET_ARCH = the builder's arch: a native build, none of that.
ARG SWIFT_IMAGE=swift:6.4-noble
FROM ${SWIFT_IMAGE}

ARG TARGET_ARCH=x86_64
ENV DEBIAN_FRONTEND=noninteractive

# swift-sdk-generator's own needs: libsqlite3-dev (its SystemSQLite module),
# and the tools it shells out to (rsync, tar, ar from binutils, xz).
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git python3 perl xz-utils zstd file binutils \
        dpkg-dev fakeroot build-essential pkg-config \
        zlib1g-dev libbrotli-dev libseccomp-dev libcap-ng-dev musl-tools \
        libssl-dev libnghttp2-dev libzstd-dev \
        libsqlite3-dev rsync \
    && rm -rf /var/lib/apt/lists/*

# Rust (Firecracker pins its own toolchain; rustup fetches it at build).
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable --no-modify-path \
    && chmod -R a+rwX /opt/rustup /opt/cargo

# Cross only: the target's amd64/arm64 packages from Ubuntu's own archive
# (the builder's sources are the other architecture's mirror), the musl
# cross compiler, and the Swift SDK.
RUN set -eux; \
    host=$(uname -m); \
    if [ "$TARGET_ARCH" = "$host" ]; then echo "native build: no cross pieces"; exit 0; fi; \
    case "$TARGET_ARCH" in \
        x86_64)  deb=amd64; mirror=http://archive.ubuntu.com/ubuntu ;; \
        aarch64) deb=arm64; mirror=http://ports.ubuntu.com/ubuntu-ports ;; \
        *) echo "unsupported TARGET_ARCH $TARGET_ARCH"; exit 1 ;; \
    esac; \
    hostdeb=$(dpkg --print-architecture); \
    dpkg --add-architecture "$deb"; \
    sed -i "s/^Types: deb\$/Types: deb\nArchitectures: $hostdeb/" /etc/apt/sources.list.d/ubuntu.sources; \
    printf 'Types: deb\nURIs: %s\nSuites: noble noble-updates noble-security\nComponents: main universe\nArchitectures: %s\nSigned-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg\n' \
        "$mirror" "$deb" > /etc/apt/sources.list.d/target.sources; \
    apt-get update; \
    gnu=$(echo "$TARGET_ARCH" | tr _ -)-linux-gnu; \
    apt-get install -y --no-install-recommends "linux-libc-dev:$deb" "musl-dev:$deb" "gcc-$gnu" "libc6-dev-$deb-cross"; \
    printf '#include <stdio.h>\nint main(void){puts("ok");return 0;}\n' > /tmp/g.c; \
    "$TARGET_ARCH-linux-gnu-gcc" -O2 -o /tmp/g /tmp/g.c && "$TARGET_ARCH-linux-gnu-gcc" -static -O2 -o /tmp/gs /tmp/g.c; \
    file /tmp/g | grep -q "$( [ "$TARGET_ARCH" = x86_64 ] && echo x86-64 || echo aarch64 )"; rm -f /tmp/g /tmp/gs /tmp/g.c; \
    specs=/usr/lib/$TARGET_ARCH-linux-musl/musl-gcc.specs; [ -f "$specs" ]; \
    printf '#!/bin/sh\nexec %s-linux-gnu-gcc "$@" -specs %s\n' "$TARGET_ARCH" "$specs" > "/usr/local/bin/$TARGET_ARCH-linux-musl-gcc"; \
    chmod 755 "/usr/local/bin/$TARGET_ARCH-linux-musl-gcc"; \
    printf '#include <stdio.h>\nint main(void){puts("ok");return 0;}\n' > /tmp/t.c; \
    "$TARGET_ARCH-linux-musl-gcc" -static -O2 -o /tmp/t /tmp/t.c; file /tmp/t | grep -Eq 'statically linked|static-pie linked'; rm -f /tmp/t /tmp/t.c; \
    mkdir -p /opt/target-debs; cd /opt/target-debs; \
    apt-get download "zlib1g:$deb" "zlib1g-dev:$deb" "libbrotli1:$deb" "libbrotli-dev:$deb" \
        "libseccomp-dev:$deb" "libcap-ng-dev:$deb" \
        "libssl3t64:$deb" "libssl-dev:$deb" "libnghttp2-14:$deb" "libnghttp2-dev:$deb" \
        "libzstd1:$deb" "libzstd-dev:$deb"; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    host=$(uname -m); \
    if [ "$TARGET_ARCH" = "$host" ]; then exit 0; fi; \
    ver=$(swift --version 2>&1 | sed -n 's/.*Swift version \([0-9][0-9.]*\).*/\1/p' | head -1); \
    [ -n "$ver" ]; \
    git clone -q --depth 1 --branch "swift-$ver-RELEASE" https://github.com/swiftlang/swift-sdk-generator /opt/sdkgen; \
    cd /opt/sdkgen; \
    swift run -c release swift-sdk-generator make-linux-sdk \
        --swift-version "$ver-RELEASE" --target-arch "$TARGET_ARCH" \
        --distribution-name ubuntu --distribution-version 24.04; \
    bundle=$(ls -d Bundles/*.artifactbundle | head -1); \
    sysroot=$(find "$bundle" -type d -name '*.sdk' | head -1); \
    [ -d "$sysroot" ]; \
    for d in /opt/target-debs/*.deb; do dpkg-deb -x "$d" "$sysroot"; done; \
    swift sdk install "$bundle"; \
    swift sdk list; \
    rm -rf /opt/sdkgen/.build /root/.cache
