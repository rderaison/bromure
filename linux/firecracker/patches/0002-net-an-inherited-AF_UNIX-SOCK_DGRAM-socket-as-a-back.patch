+        use crate::devices::virtio::device::VirtioDevice;
+        use crate::devices::virtio::generated::virtio_net::*;
+        let (ours, peer) = dgram_pair(libc::SOCK_DGRAM);
+        let net = crate::devices::virtio::net::Net::new(
+            "eth0".into(),
+            &format!("fd:{ours}"),
+            None,
+            Default::default(),
+            Default::default(),
+            None,
+        )
+        .unwrap();
+        for f in [
+            VIRTIO_NET_F_CSUM,
+            VIRTIO_NET_F_GUEST_CSUM,
+            VIRTIO_NET_F_HOST_TSO4,
+            VIRTIO_NET_F_GUEST_TSO4,
+        ] {
+            assert_eq!(net.avail_features() & (1 << f), 0, "feature {f}");
+        }
+        assert_eq!(net.iface_name(), format!("fd:{ours}"));
+        unsafe { libc::close(peer) };
+    }
