@@ -0,0 +1,83 @@
+// Copyright 2026 Bromure. All Rights Reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Saving and restoring vhost-user-fs devices: the virtio state, each
+//! ring's base and the backend's own state (virtiofsd's, through
+//! VHOST_USER_PROTOCOL_F_DEVICE_STATE). The restored device connects to a
+//! fresh backend at the same socket path, which the caller has started.
+
+use serde::{Deserialize, Serialize};
+
+use super::device::VhostUserFs;
+use super::{NUM_QUEUES, QUEUE_SIZE, VhostUserFsError};
+use crate::devices::virtio::device::{DeviceState, VirtioDeviceType};
+use crate::devices::virtio::persist::VirtioDeviceState;
+use crate::snapshot::Persist;
+use crate::utils::u64_to_usize;
+use crate::vmm_config::fs::FsDeviceConfig;
+use crate::vstate::memory::GuestMemoryMmap;
+
+/// vhost-user-fs device state.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct VhostUserFsState {
+    pub id: String,
+    pub tag: String,
+    pub socket_path: String,
+    pub virtio_state: VirtioDeviceState,
+    /// Where each ring's backend stopped.
+    pub vring_bases: Vec<u16>,
+    /// The backend's state blob.
+    pub backend_state: Vec<u8>,
+}
+
+/// What a restored fs device needs.
+#[derive(Debug)]
+pub struct FsConstructorArgs {
+    pub mem: GuestMemoryMmap,
+}
+
+impl Persist<'_> for VhostUserFs {
+    type State = VhostUserFsState;
+    type ConstructorArgs = FsConstructorArgs;
+    type Error = VhostUserFsError;
+
+    fn save(&self) -> Self::State {
+        // create_snapshot ran prepare_snapshot on every fs device first.
+        let (vring_bases, backend_state) = self.saved_backend.clone().unwrap_or_default();
+        VhostUserFsState {
+            id: self.id.clone(),
+            tag: self.tag.clone(),
+            socket_path: self.vu_handle.socket_path.clone(),
+            virtio_state: VirtioDeviceState::from_device(self),
+            vring_bases,
+            backend_state,
+        }
+    }
+
+    fn restore(
+        constructor_args: Self::ConstructorArgs,
+        state: &Self::State,
+    ) -> Result<Self, Self::Error> {
+        let mut fs = VhostUserFs::new(&FsDeviceConfig {
+            fs_id: state.id.clone(),
+            tag: state.tag.clone(),
+            socket: state.socket_path.clone(),
+        })?;
+        fs.queues = state
+            .virtio_state
+            .build_queues_checked(
+                &constructor_args.mem,
+                VirtioDeviceType::Fs,
+                u64_to_usize(NUM_QUEUES),
+                QUEUE_SIZE,
+            )
+            .map_err(VhostUserFsError::Persist)?;
+        fs.avail_features = state.virtio_state.avail_features;
+        fs.acked_features = state.virtio_state.acked_features;
+        if state.virtio_state.activated {
+            fs.restore_backend = Some((state.vring_bases.clone(), state.backend_state.clone()));
+        }
+        fs.device_state = DeviceState::Inactive;
+        Ok(fs)
+    }
+}
