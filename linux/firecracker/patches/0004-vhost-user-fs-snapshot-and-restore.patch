+
+    /// Stops every ring (GET_VRING_BASE: the backend finishes what it took,
+    /// then reports where it stopped) and takes the backend's internal state
+    /// (SET_DEVICE_STATE_FD save + CHECK_DEVICE_STATE): what a restore hands
+    /// back. The rings stay stopped: the VM is going away.
+    pub fn save_backend(&self, num_queues: usize) -> Result<(Vec<u16>, Vec<u8>), VhostUserError> {
+        let mut bases = Vec::with_capacity(num_queues);
+        for i in 0..num_queues {
+            let base = self
+                .vu
+                .get_vring_base(i)
+                .map_err(VhostUserError::VhostUserGetVringBase)?;
+            bases.push(u16::try_from(base).unwrap_or(u16::MAX));
+        }
+        let (mut ours, theirs) = Self::pipe()?;
+        let reply = self
+            .vu
+            .set_device_state_fd(
+                VhostTransferStateDirection::SAVE,
+                VhostTransferStatePhase::STOPPED,
+                theirs,
+            )
+            .map_err(VhostUserError::VhostUserDeviceState)?;
+        // The backend may hand back a pipe of its own to read from instead.
+        if let Some(file) = reply {
+            ours = file;
+        }
+        let mut state = Vec::new();
+        ours.read_to_end(&mut state)
+            .map_err(VhostUserError::DeviceStatePipe)?;
+        self.vu
+            .check_device_state()
+            .map_err(VhostUserError::VhostUserDeviceState)?;
+        Ok((bases, state))
+    }
+
+    /// A pipe: (read end, write end).
+    fn pipe() -> Result<(File, OwnedFd), VhostUserError> {
+        let mut fds = [0i32; 2];
+        // SAFETY: fds is a valid 2-element array for pipe2 to fill.
+        if unsafe { libc::pipe2(fds.as_mut_ptr(), libc::O_CLOEXEC) } != 0 {
+            return Err(VhostUserError::DeviceStatePipe(std::io::Error::last_os_error()));
+        }
+        // SAFETY: pipe2 just returned these two fds, owned by nobody else.
+        Ok(unsafe { (File::from_raw_fd(fds[0]), OwnedFd::from_raw_fd(fds[1])) })
+    }
+
+    /// Writes `state` back into a restored backend (SET_DEVICE_STATE_FD
+    /// load + CHECK_DEVICE_STATE), while its rings are still stopped.
+    fn load_backend_state(&self, state: &[u8]) -> Result<(), VhostUserError> {
+        let (ours, theirs) = Self::pipe()?;
+        let (read_end, mut write_end): (OwnedFd, File) = {
+            // For a load the backend reads: hand it the read end, write ours.
+            let r: OwnedFd = ours.into();
+            let w: File = File::from(theirs);
+            (r, w)
+        };
+        let reply = self
+            .vu
+            .set_device_state_fd(
+                VhostTransferStateDirection::LOAD,
+                VhostTransferStatePhase::STOPPED,
+                read_end,
+            )
+            .map_err(VhostUserError::VhostUserDeviceState)?;
+        if let Some(file) = reply {
+            write_end = file;
+        }
+        write_end
+            .write_all(state)
+            .map_err(VhostUserError::DeviceStatePipe)?;
+        drop(write_end);
+        self.vu
+            .check_device_state()
+            .map_err(VhostUserError::VhostUserDeviceState)
+    }
