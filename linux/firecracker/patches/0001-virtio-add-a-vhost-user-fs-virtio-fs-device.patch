diff --git a/src/vmm/src/persist.rs b/src/vmm/src/persist.rs
index 71a0345..b872240 100644
--- a/src/vmm/src/persist.rs
+++ b/src/vmm/src/persist.rs
@@ -171,6 +171,19 @@ pub fn create_snapshot(
     vm_info: &VmInfo,
     params: &CreateSnapshotParams,
 ) -> Result<(), CreateSnapshotError> {
+    // A snapshot without the vhost-user-fs devices would restore a guest
+    // whose mounts point at nothing: refuse it.
+    let mut has_fs = false;
+    vmm.device_manager.for_each_virtio_device(|t, _| {
+        has_fs |= t == crate::devices::virtio::device::VirtioDeviceType::Fs
+    });
+    if has_fs {
+        return Err(CreateSnapshotError::MicrovmState(
+            MicrovmStateError::NotAllowed(
+                "vhost-user-fs devices do not support snapshotting".into(),
+            ),
+        ));
+    }
     let microvm_state = vmm
         .save_state(vm_info)
         .map_err(CreateSnapshotError::MicrovmState)?;
