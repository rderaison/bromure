                         }
                     }
                     0x70 => self.device_status,
+                    // SHMLenLow/High, SHMBaseLow/High: no device here has a
+                    // shared memory region, which the spec says reads as all
+                    // ones. Drivers that probe for one (virtio-fs DAX) fail
+                    // the device on anything else.
+                    0xb0 | 0xb4 | 0xb8 | 0xbc => 0xffff_ffff,
                     0xfc => self.config_generation,
                     _ => {
                         warn!("unknown virtio mmio register read: {:#x}", offset);
@@ -333,6 +338,8 @@ impl BusDevice for MmioTransport {
                     0x94 => self.update_queue_field(|q| hi(&mut q.avail_ring_address, v)),
                     0xa0 => self.update_queue_field(|q| lo(&mut q.used_ring_address, v)),
                     0xa4 => self.update_queue_field(|q| hi(&mut q.used_ring_address, v)),
+                    // SHMSel: there are no regions to select (see the read side).
+                    0xac => {}
                     _ => {
                         warn!("unknown virtio mmio register write: {:#x}", offset);
                     }
@@ -691,6 +698,14 @@ pub(crate) mod tests {
         d.read(0x0, 0x34, &mut buf[..]);
         assert_eq!(read_le_u32(&buf[..]), 16);
 
+        // No shared memory region: its length and base read as all ones.
+        d.write(0x0, 0xac, &[0, 0, 0, 0]);
+        for offset in [0xb0, 0xb4, 0xb8, 0xbc] {
+            buf.copy_from_slice(&[0; 4]);
+            d.read(0x0, offset, &mut buf[..]);
+            assert_eq!(read_le_u32(&buf[..]), 0xffff_ffff);
+        }
+
         d.read(0x0, 0x44, &mut buf[..]);
         assert_eq!(read_le_u32(&buf[..]), u32::from(false));
 
