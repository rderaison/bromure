@@ -0,0 +1,35 @@
+// Copyright 2026 Bromure. All Rights Reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! vhost-user-fs: a virtio-fs device whose queues a vhost-user backend
+//! (virtiofsd) serves. Firecracker only relays the vhost-user setup; file
+//! requests never pass through it.
+
+pub mod device;
+pub mod event_handler;
+
+pub use self::device::{VhostUserFs, VhostUserFsImpl};
+use crate::devices::virtio::vhost_user::VhostUserError;
+
+/// Request queues: one is what virtiofsd serves best (it is single-queue
+/// unless built for more).
+pub const NUM_REQUEST_QUEUES: u32 = 1;
+/// The high-priority queue (FUSE_INTERRUPT, FORGET) plus the request queues.
+pub const NUM_QUEUES: u64 = 1 + NUM_REQUEST_QUEUES as u64;
+/// Queue size, as QEMU's vhost-user-fs default.
+pub const QUEUE_SIZE: u16 = 1024;
+/// virtio_fs_config.tag length; a shorter tag is NUL-padded.
+pub const TAG_LEN: usize = 36;
+
+/// vhost-user-fs device error.
+#[derive(Debug, thiserror::Error, displaydoc::Display)]
+pub enum VhostUserFsError {
+    /// Invalid tag {0:?}: 1 to 36 bytes, no NUL
+    Tag(String),
+    /// Snapshotting of vhost-user-fs devices is not supported
+    SnapshottingNotSupported,
+    /// Vhost-user error: {0}
+    VhostUser(VhostUserError),
+    /// Error opening eventfd: {0}
+    EventFd(std::io::Error),
+}
