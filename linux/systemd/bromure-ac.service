# bromure-ac: the headless Bromure Agentic Coding host, as a systemd *user* service.
# Installed by linux/install-user-service.sh into ~/.config/systemd/user/.
[Unit]
Description=Bromure Agentic Coding (headless host)
Documentation=https://github.com/rderaison/bromure
After=default.target

[Service]
# READY=1 comes from the daemon (sd_notify through the C shim) once
# control.sock is listening; NotifyAccess=main ignores notifications from children.
Type=notify
NotifyAccess=main
ExecStart="@BIN@" daemon
Environment="BROMURE_AC_IMAGE=@IMAGE@"
Environment="BROMURE_AGENTD=@AGENTD@"
# Where the install put the PII detector's model. The paths here are quoted,
# and the install escapes what systemd would otherwise expand or split.
Environment="BROMURE_PII_MODEL_DIR=@PIIMODEL@"
# Only the daemon is signalled: on stop, the daemon's own SIGTERM path
# suspends or shuts down each workspace as its close action says (within
# 80 s: TimeoutStopSec leaves room for the snapshots), stops what's left
# (15 s), then ends the rest and passt. If the daemon dies (crash, OOM), its VMs keep
# running in the cgroup and the restarted daemon re-adopts them (pidfile
# identity, Firecracker's API socket, its network end and vsock listener). A daemon that hangs past
# TimeoutStopSec is SIGKILLed alone; ExecStopPost= then ends what's left in
# the cgroup when the stop was asked for (a stop/restart job) or no restart
# follows, and leaves it for the restarted daemon after a crash.
KillMode=process
ExecStopPost="@BIN@" stop-post
# passt's socket and pidfd, and each VM's network socket and vsock listener:
# a crash restart takes passt (and its open flows) and the VMs back.
FileDescriptorStoreMax=64
TimeoutStopSec=120
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
