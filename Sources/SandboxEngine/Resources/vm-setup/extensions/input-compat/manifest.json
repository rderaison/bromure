{
  "manifest_version": 3,
  "name": "Bromure Input Compatibility",
  "version": "1.0.0",
  "description": "Gives trackpad wheel events the values Chrome on macOS reports.",
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "wheel-compat.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    }
  ]
}
