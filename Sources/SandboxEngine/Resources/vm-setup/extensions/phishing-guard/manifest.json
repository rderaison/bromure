{
  "manifest_version": 3,
  "name": "Bromure Phishing Guard",
  "version": "2.1.0",
  "description": "Detects and warns about potential phishing sites when password fields are present.",
  "key": "",
  "permissions": [
    "activeTab",
    "storage",
    "webNavigation",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "clickfix-inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "jsQR.min.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bromure Phishing Guard"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "top-domains.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}