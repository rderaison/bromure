/* Cloud emulators: the floci family (floci-az, floci-gcp, floci-oci), versions from Docker Hub */
"Azure emulator (floci-az)" = "Emulador de Azure (floci-az)";
"Google Cloud emulator (floci-gcp)" = "Emulador de Google Cloud (floci-gcp)";
