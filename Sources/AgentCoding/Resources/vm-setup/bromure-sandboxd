# ---------------------------------------------------------------------------
# Bromure's additions layer
# ---------------------------------------------------------------------------
#
# The equivalent of the network policy's `_provider_*` rules: paths the workload
# cannot function without *in this VM specifically*, which the user never asked
# for and must be shown. Deliberately tiny. It is NOT a place to put /usr, /bin
# or /lib — a policy that forgets those is a policy that is wrong, and silently
# repairing it would mean the user's stated policy is not the one being
# enforced. If an agent CLI turns out to need something that a valid OpenShell
# policy wouldn't list, that is a finding to report, not a path to add here.

ADDITIONS_READ_WRITE = [
    # Where the sandboxed tmux server creates its socket. Without this the
    # server cannot bind and there is no session at all. Note the workload is
    # granted write here by Landlock AND by the `bromure-tmux` group; the group
    # is what keeps agentd out, and Landlock is what keeps the sandbox in.
    (os.path.join(RUN_DIR, "server"), "the sandboxed tmux server's socket directory"),
    # Pty allocation for panes. Bromure's pane model is ptys; OpenShell's
    # workload model is a single command and never needs these.
    ("/dev/ptmx", "pty allocation for panes"),
    ("/dev/pts", "pty slaves for panes"),
    # Login records. Every new pane is a login shell, so tmux calls the
    # `utempter` helper, and without this Landlock denies it and the journal
    # gains `utempter: pututline: Permission denied` on every pane — plus `who`
    # and `w` come back empty. A single FILE, not a directory, so this grants
    # nothing else under /run (ctl.sock in particular stays out of reach).
    #
    # Inert under the strict sandbox, and worth knowing why: `utempter` is
    # setgid `utmp`, and `no_new_privs` makes execve ignore the setgid bit, so
    # the helper runs with the workload's own gid and cannot write /run/utmp
    # whatever Landlock says. Under strict that message is expected and
    # harmless. This addition is what fixes it in the Landlock-only mode, where
    # there is no nnp.
    ("/run/utmp", "login records for who(1)/w(1); our panes are login shells"),
    # The other half of the same mechanism. `utempter` writes BOTH /run/utmp and
    # /var/log/wtmp for every pane, so granting only the first left one
    # `sandbox_denied` per pane, forever -- recurring noise from Bromure's own
    # session plumbing, which is exactly what makes a real denial hard to see.
    # Inert under the strict sandbox for the reason below.
    ("/var/log/wtmp", "the login-record log utempter writes alongside /run/utmp"),
    # bash opens /dev/tty to look for a controlling terminal -- on every
    # `sh -c`, not only interactive ones. A policy that does not list it
    # therefore produces one `sandbox_denied` per `vm exec`, forever, which is
    # noise on a timer and tells nobody anything: the shell is probing, not the
    # agent. Same justification as /dev/ptmx and /dev/pts: Bromure's workload is
    # panes, OpenShell's is one command.
    ("/dev/tty", "the controlling terminal bash probes for on every shell"),
]

