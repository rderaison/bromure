# ---------------------------------------------------------------------------
# DNS, and OpenShell's baseline
# ---------------------------------------------------------------------------

def resolver_additions():
    """The read-only paths a resolver needs. Returns [(path, why)].

    **DNS was dead in every sandboxed workspace and nothing said so.** On this
    image `/etc/resolv.conf` is a symlink to
    `/run/systemd/resolve/stub-resolv.conf`, and Landlock checks the RESOLVED
    path -- so a policy granting `/etc` does not grant the file `/etc/resolv.conf`
    points at. Every hostname lookup then failed with
    `Temporary failure in name resolution`, which reads as a network-policy
    denial rather than a filesystem one. OpenShell never meets this because its
    containers have a real `/etc/resolv.conf`.

    **Unconditional**, because the alternative is a feature that silently does
    not work: without it every hostname-based network rule is unusable, and the
    symptom points at the wrong layer. It is also pure Bromure plumbing -- the
    guest runs systemd-resolved, which is an implementation detail of our image
    and not something a user's policy should have to know.

    **The DIRECTORY, not the file, and that is not laziness.** Measured: grant the
    file and the first time systemd-resolved rewrites it -- which it does by
    atomic rename, on any DHCP renewal or link change -- the path points at a new
    inode that no rule covers, and DNS dies mid-session. Granting the file passes
    every test written at boot and fails hours later. `PathBeneath` on the
    directory covers replacements.

    What that directory also contains is `io.systemd.Resolve`, a world-writable
    varlink socket -- and granting it read-only gives away nothing, because
    Landlock at this ABI does not mediate connecting to a unix socket at all
    (that is ABI 6 scoping). The workload could already reach it.

    **`/etc/hosts` and `/etc/nsswitch.conf` are added too, and the reason is
    robustness rather than necessity -- measured both ways.** Round 13 concluded
    they were unnecessary because `getaddrinfo` resolved a real DNS name with no
    `/etc` granted at all, which was true and was the wrong test. The case that
    matters is a name that exists *only* in `/etc/hosts`: `policy.local`, the
    advisor, which the host maps to a TEST-NET-1 address it intercepts.

    That name also resolves with no `/etc` granted -- measured -- but only because
    **systemd-resolved reads `/etc/hosts` itself, as root, outside the sandbox**,
    and answers the stub query at 127.0.0.53. So resolution works today by way of
    a daemon, not by way of the policy. Two reasons to grant the files anyway:

    * without a readable `nsswitch.conf`, glibc falls back to its built-in
      `dns [!UNAVAIL=return] files`, which puts **DNS ahead of the hosts file**
      and returns on NXDOMAIN without ever consulting `files`. On any image whose
      resolver is not systemd-resolved, a hosts-only name then silently does not
      resolve. Granting the file restores Ubuntu's `files dns` order, which is
      also the order the mapping is meant to have;
    * two world-readable configuration files with no secrets in them is about the
      cheapest robustness available, and the failure they guard against is silent.

    So this is a deliberate, named widening of two files -- not `/etc` -- with the
    measurement recorded so nobody has to re-derive why.
    """
    out = []
    link = "/etc/resolv.conf"
    try:
        target = os.path.realpath(link)
    except OSError:
        return out
    if not os.path.exists(target):
        return out
    parent = os.path.dirname(target)
    if os.path.abspath(parent) not in ("/etc", "/", ""):
        out.append((parent, "DNS resolver configuration (%s resolves here; the "
                            "directory rather than the file, so a resolver "
                            "rewrite cannot break name resolution mid-session)"
                            % link))
    elif os.path.isfile(target):
        # A real file in /etc. Granted by name so a policy without /etc still
        # resolves; a rewrite-by-rename would still break it, but nothing here
        # rewrites /etc/resolv.conf on this image.
        out.append((target, "DNS resolver configuration"))
    # Name resolution, as distinct from the resolver's own configuration: the
    # hosts file the advisor mapping lives in, and the switch file that decides
    # it is consulted before DNS. `agentd` writes /etc/hosts with `tee`, which
    # truncates in place, so this file-level rule is not invalidated by the
    # advisor task the way a rename would invalidate it.
    for path in ("/etc/hosts", "/etc/nsswitch.conf"):
        if os.path.isfile(path):
            out.append((path, "name resolution (%s)" % os.path.basename(path)))
    return out


# OpenShell's own baseline enrichment, from its `landlock.rs`: when the policy has
# at least one network rule it adds these, read-only and read-write respectively,
# for the paths that exist and are not already listed. Its own e2e test
# `hard_requirement_accepts_enriched_device_path` depends on it -- a policy listing
# neither `/dev/urandom` nor `/tmp` whose workload reads `/dev/urandom`.
#
# DESIGN.md previously recorded a decision NOT to have a baseline, on the grounds
# that a policy should be honoured verbatim. That was the right instinct and the
# wrong call: this is not Bromure inventing a baseline, it is OpenShell's
# documented behaviour, and diverging from it makes policies that work upstream
# fail here. Parity wins. It stays keyed off the same condition, with the same
# paths, so there is one rule to remember rather than two.
OPENSHELL_BASELINE_READ_ONLY = ("/usr", "/lib", "/etc", "/app", "/var/log",
                                "/proc", "/dev/urandom")
OPENSHELL_BASELINE_READ_WRITE = ("/tmp", "/dev/null")


def network_rule_count(spec):
    """How many network rules the policy has, or None when the host did not say.

    `None` and `0` are different and the difference matters: with 0 there is no
    baseline, with `None` we cannot tell, and silently treating the second as the
    first is how a workspace would lose the baseline without anyone noticing. So
    the caller warns on `None` rather than guessing.
    """
    for key in ("network_policies", "network_rules", "network"):
        if key not in spec:
            continue
        value = spec[key]
        if value is None:
            return 0
        if isinstance(value, bool):
            return 1 if value else 0
        if isinstance(value, int):
            return max(0, value)
        if isinstance(value, (list, tuple)):
            return len(value)
        if isinstance(value, dict):
            # Either a rule container or a single rule; both mean "at least one"
            # when non-empty.
            rules = value.get("rules")
            if isinstance(rules, (list, tuple)):
                return len(rules)
            return 1 if value else 0
    return None


def openshell_baseline_additions(spec, policy, workdirs, status):
    """OpenShell's enrichment. Returns (read_only, read_write), each [(path, why)]."""
    if not policy.filesystem.present:
        return [], []
    count = network_rule_count(spec)
    if count is None:
        status["warnings"].append(
            "cannot apply OpenShell's baseline enrichment: the spec carries no "
            "network rules, so whether the policy has any is unknown. Stage "
            "`network_policies` in openshell-sandbox.json (a list; an empty list "
            "means none) and this resolves itself.")
        return [], []
    if count < 1:
        return [], []
    already = set()
    for path in (list(policy.filesystem.read_only)
                 + list(policy.filesystem.read_write)
                 + (list(workdirs) if policy.filesystem.include_workdir else [])):
        if isinstance(path, str) and path:
            already.add(os.path.abspath(path))
    why = "OpenShell baseline (policy has network rules)"
    read_only, read_write = [], []
    for group, table in ((read_only, OPENSHELL_BASELINE_READ_ONLY),
                         (read_write, OPENSHELL_BASELINE_READ_WRITE)):
        for path in table:
            if path in already or not os.path.exists(path):
                continue
            group.append((path, why))
    return read_only, read_write


# Additions whose path is not known until the policy is read: the run_as user's
# home, the resolver directory, and OpenShell's baseline enrichment. Kept apart
# from the constant tables, but rendered by the same mechanism so the host shows
# every addition with a reason and there is no second code path to forget.
#
# `{path: (why, "ro" | "rw")}`, reset per launch.
DYNAMIC_ADDITIONS = {}


def note_addition(path, why, mode):
    DYNAMIC_ADDITIONS[path] = (why, mode)


def additions_for_report(applied_paths):
    """The additions actually applied, in the shape the host renders."""
    read_write = [path for path, _ in ADDITIONS_READ_WRITE
                  if path in applied_paths]
    read_only = [path for path, _ in ADDITIONS_READ_ONLY
                 if path in applied_paths]
    why = {path: reason for path, reason
           in list(ADDITIONS_READ_WRITE) + list(ADDITIONS_READ_ONLY)
           if path in applied_paths}
    for path, (reason, mode) in DYNAMIC_ADDITIONS.items():
        if path not in applied_paths:
            continue
        target = read_write if mode == "rw" else read_only
        if path not in target:
            target.append(path)
        why[path] = reason
    return {"read_write": read_write, "read_only": read_only, "why": why}


