def build_marker():
    """Short hashes of the guest scripts actually running. For `status.json`.

    This exists because a whole round was spent on a blocker whose symptoms were
    consistent with the fix not being deployed, and neither side could tell from
    the status line which code the workspace was running. The supervisor is in the
    right place to answer it: it is started by agentd from the meta share, so it
    can hash itself, its modules, and the agentd source beside it.

    Cheap -- four small files, once per start -- and it turns "is the fix in?" from
    an exchange of guesses into a field in the log.
    """
    import hashlib
    here = os.path.dirname(os.path.abspath(__file__))
    out = {}
    # Every guest file whose content can change what a workspace does. attestd
    # and the status builder were missing, and round 17 changed both -- so the
    # host could not have told from the status line whether that round was
    # deployed, which is the exact question this field exists to answer.
    for label, path in (("sandboxd", os.path.abspath(__file__)),
                        ("openshell", os.path.join(here, "bromure_openshell.py")),
                        ("idmap", os.path.join(here, "bromure_idmap.py")),
                        ("status", os.path.join(here, "bromure_sandbox_status.py")),
                        ("sentryd", os.path.join(here, "bromure-sentryd")),
                        ("strict", os.path.join(here, "bromure-strict.py")),
                        ("attestd", os.path.join(META, "bromure-attestd.py")),
                        ("agentd", os.path.join(META, "bromure-agentd.py"))):
        try:
            with open(path, "rb") as handle:
                out[label] = hashlib.sha256(handle.read()).hexdigest()[:12]
        except OSError:
            out[label] = None
    return out


