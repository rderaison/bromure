# ---------------------------------------------------------------------------
# Where the socket lives, and why nothing outside the sandbox can create one
# ---------------------------------------------------------------------------
#
# This is the part that makes the boundary real rather than a convention, and it
# took two wrong answers to get to.
#
# The threat: the agent, inside the sandbox, runs `tmux kill-server` — it is its
# own server, nothing stops it — while leaving a detached process alive. The next
# time anything OUTSIDE the sandbox runs a tmux command against that socket, the
# tmux client starts a server itself (many commands carry CMD_STARTSERVER, not
# just `new-session`). That server is unsandboxed, and the surviving process can
# `send-keys` into its panes. Landlock at ABI 4 does not scope unix-socket
# connects, so nothing blocks the last step. Full escape.
#
# What does NOT work:
#
#   * **Permissions on the socket directory.** In the default configuration
#     agentd and the workload share uid 1000 — that is what keeps the virtiofs
#     workdirs writable. Any mode that lets the server bind also lets agentd
#     bind; any mode that stops agentd stops the server. There is no DAC answer
#     while the uids are equal.
#   * **A private mount namespace with a tmpfs for the socket**, exposing it to
#     agentd with a bind mount out of `/proc/<pid>/root`. The kernel refuses:
#     `do_loopback` calls `check_mnt`, which requires the source mount to be in
#     the caller's own namespace. Measured, not guessed.
#
# What does work: a **supplementary group** the sandboxed server has and agentd
# does not. The uids stay equal; the group list does not.
#
#   /run/bromure-sandbox/            root:root          0755
#       nothing but root creates entries here. `ctl.sock` lives here.
#   /run/bromure-sandbox/server/     root:bromure-tmux  0771
#       group rwx  -> the sandboxed server can create its socket
#       other  --x -> agentd can traverse to the socket but create nothing
#   /run/bromure-sandbox/server/tmux.sock
#       created by the server, mode 0600, owned by the workload uid, so agentd
#       (same uid) can connect to it.
#
# Measured consequences, all four in tests/test_sandbox.sh:
#   * agentd connects to the server fine;
#   * agentd trying to start a server at that path fails with
#     "error creating … (Permission denied)";
#   * after `kill-server`, agentd cannot even resurrect one there — it cannot
#     unlink the stale socket, so it gets EADDRINUSE;
#   * a sandboxed process CAN create another server in `server/`, but that
#     server is inside the sandbox too, so it buys nothing.
#
# `bromure-tmux` is a system group with **no members in /etc/group**. The only
# way to hold it is for this supervisor, as root, to grant it explicitly to the
# child it is about to confine (`drop_privileges(extra_groups=…)`).

SERVER_GROUP = "bromure-tmux"
SERVER_DIR = os.path.join(RUN_DIR, "server")
SERVER_SOCKET = os.path.join(SERVER_DIR, "tmux.sock")
CONTROL_SOCKET = os.path.join(RUN_DIR, "ctl.sock")

# Rate limit on server starts: at most this many in this window, and nothing
# else. A well-behaved workspace asks once per boot; a burst means either
# something is killing the server repeatedly or something is looking for a race
# to win, and either way the host wants to know.
#
# There is deliberately NO minimum interval between starts. An earlier version
# had one, and it refused a perfectly ordinary sequence — server ends, user
# reattaches immediately — which to the user looks like a broken workspace and
# to the host looks like a sandbox failure. A count over a window bounds the
# damage just as well without ever refusing a first legitimate retry.
START_BURST_WINDOW = 60.0
START_BURST_MAX = 5


def ensure_server_group():
    """The group that separates 'may create the server socket' from 'may connect'."""
    try:
        return grp.getgrnam(SERVER_GROUP).gr_gid
    except KeyError:
        pass
    subprocess.run(["groupadd", "--system", SERVER_GROUP],
                   check=True, capture_output=True)
    return grp.getgrnam(SERVER_GROUP).gr_gid


def prepare_directories(group_gid):
    """Lay out the two directories, idempotently and by explicit mode.

    `os.makedirs(mode=…)` is subject to umask; chmod is not, and getting 0771
    wrong here silently reopens the escape, so both are set explicitly.
    """
    os.makedirs(RUN_DIR, exist_ok=True)
    os.chown(RUN_DIR, 0, 0)
    os.chmod(RUN_DIR, 0o755)
    os.makedirs(SERVER_DIR, exist_ok=True)
    os.chown(SERVER_DIR, 0, group_gid)
    os.chmod(SERVER_DIR, 0o771)
    # root:root 0755 with a root-owned empty config: agentd (uid 1000) reads it,
    # and nothing running as the workspace user can put a credential helper in
    # it. See DOCKER_CONFIG_DIR.
    os.makedirs(DOCKER_CONFIG_DIR, exist_ok=True)
    os.chown(DOCKER_CONFIG_DIR, 0, 0)
    os.chmod(DOCKER_CONFIG_DIR, 0o755)
    config = os.path.join(DOCKER_CONFIG_DIR, "config.json")
    if not os.path.exists(config):
        with open(config, "w") as handle:
            handle.write("{}\n")
        os.chown(config, 0, 0)
        os.chmod(config, 0o644)


def verify_directories(group_gid):
    """Refuse to run if the layout is not what the escape analysis assumed."""
    problems = []
    run = os.stat(RUN_DIR)
    if run.st_uid != 0 or (run.st_mode & 0o777) != 0o755:
        problems.append("%s is uid %d mode %o, expected 0 0755"
                        % (RUN_DIR, run.st_uid, run.st_mode & 0o777))
    srv = os.stat(SERVER_DIR)
    if srv.st_uid != 0 or srv.st_gid != group_gid or (srv.st_mode & 0o777) != 0o771:
        problems.append("%s is uid %d gid %d mode %o, expected 0 %d 0771"
                        % (SERVER_DIR, srv.st_uid, srv.st_gid,
                           srv.st_mode & 0o777, group_gid))
    members = grp.getgrgid(group_gid).gr_mem
    if members:
        # A member in /etc/group would hold the group without this supervisor
        # granting it -- including agentd, if someone added the workspace user.
        problems.append("group %s has members in /etc/group (%s); the whole "
                        "separation depends on it having none"
                        % (SERVER_GROUP, ", ".join(members)))
    return problems


