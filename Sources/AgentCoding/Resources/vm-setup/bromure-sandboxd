def _stay_up_reporting(status):
    """A fatal misconfiguration must not leave a DEAD unit behind.

    Exiting non-zero under `Restart=always` makes systemd restart, fail, and
    within five attempts hit the start limit — after which the unit is gone for
    the rest of the boot. agentd then waits its full timeout for a control socket
    that will never appear, and the host is told nothing about why. Measured
    exactly that way: `bromure-sandboxd.service: start-limit-hit`.
    
    So instead: publish the reason, open the control socket anyway, and answer
    `status` requests with it. agentd finds the socket immediately, learns there
    is no server and why, and refuses to start an unsandboxed session — which is
    the correct outcome, arrived at in a second rather than a timeout.
    """
    log("staying up to report the failure rather than exiting")
    try:
        os.makedirs(RUN_DIR, exist_ok=True)
        os.chmod(RUN_DIR, 0o755)
        try:
            os.unlink(CONTROL_SOCKET)
        except OSError:
            pass
        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        listener.bind(CONTROL_SOCKET)
        # Same permissions as the working path: agentd's group, not the world.
        # A failure reason is not a secret, but an inconsistent mode here is the
        # kind of thing that gets copied into a path where it does matter.
        try:
            os.chown(CONTROL_SOCKET, 0, pwd.getpwnam(WORKSPACE_USER).pw_gid)
        except (KeyError, OSError):
            pass
        os.chmod(CONTROL_SOCKET, 0o660)
        listener.listen(8)
    except OSError as exc:
        log("cannot even open the control socket: %s" % exc)
        return 2
    reply = (json.dumps({"ok": False, "reason": status.get("degraded_reason"),
                         "status": status}) + "\n").encode()
    while True:
        try:
            conn, _ = listener.accept()
        except OSError:
            time.sleep(0.5)
            continue
        try:
            conn.settimeout(5.0)
            conn.recv(4096)
            conn.sendall(reply)
        except OSError:
            pass
        finally:
            try:
                conn.close()
            except OSError:
                pass


SECCOMP_ACTIONS_LOGGED = "/proc/sys/kernel/seccomp/actions_logged"


def ensure_seccomp_logging(status):
    """Make sure a refused syscall is one the kernel will tell us about.

    The seccomp filters ask for `SECCOMP_FILTER_FLAG_LOG`, but the kernel only
    calls `audit_seccomp` -- which is the sentry's probe point, and the only trace
    a refused syscall leaves anywhere -- when the action is ALSO listed in
    `actions_logged`. Both halves are required and only one of them is ours.

    Measured as already correct on this image (`errno` is in the default set), so
    this is a guard against an image change rather than a fix. It is written only
    when something is missing, because a sysctl written on every boot is a line in
    every audit log for no reason.
    """
    wanted = {"errno", "kill_thread", "kill_process", "trap"}
    try:
        with open(SECCOMP_ACTIONS_LOGGED) as handle:
            current = set(handle.read().split())
    except OSError as exc:
        status["warnings"].append(
            "cannot read %s (%s): a seccomp denial may leave no trace"
            % (SECCOMP_ACTIONS_LOGGED, exc))
        return
    available = wanted & _seccomp_actions_available()
    if available <= current:
        return
    merged = sorted(current | available)
    try:
        with open(SECCOMP_ACTIONS_LOGGED, "w") as handle:
            handle.write(" ".join(merged))
        log("seccomp actions_logged: %s" % " ".join(merged))
    except OSError as exc:
        status["warnings"].append(
            "cannot enable seccomp logging for %s (%s): those denials will be "
            "invisible to the sentry"
            % (", ".join(sorted(available - current)), exc))


def _seccomp_actions_available():
    try:
        with open("/proc/sys/kernel/seccomp/actions_avail") as handle:
            return set(handle.read().split())
    except OSError:
        return set()


def build_plan(spec, policy, status, group_gid, sandbox_cgroup=None):
    """Resolve everything once. Returns (Plan, exit_code); one of them is None."""
    workdirs = resolve_workdirs(spec)

    # `no_new_privs` is irreversible and disables every setuid binary in the
    # tree, `sudo` included. A workspace without the strict sandbox still grants
    # the agent user sudo, and silently breaking it would be worse than not
    # applying the filters. So the process/seccomp layer requires the strict
    # sandbox; Landlock, which touches no credentials, does not.
    strict_applied = os.path.exists(STRICT_DONE)
    strict_requested = bool(spec.get("strict_sandbox"))
    apply_seccomp = (policy.process.present or strict_applied) and \
                    (strict_applied or strict_requested)
    if apply_seccomp:
        ensure_seccomp_logging(status)
    if policy.process.present and not (strict_applied or strict_requested):
        status["warnings"].append(
            "process policy present without strict_sandbox: seccomp and "
            "no_new_privs not applied (they would disable sudo, which this "
            "workspace still grants). Landlock is unaffected.")

    run_as_user = policy.process.run_as_user if policy.process.present else None
    run_as_group = policy.process.run_as_group if policy.process.present else None
    try:
        ensure_user(run_as_user)
        if run_as_group and not osh._is_numeric(run_as_group):
            try:
                grp.getgrnam(run_as_group)
            except KeyError:
                subprocess.run(["groupadd", "--system", run_as_group],
                               check=True, capture_output=True)
    except (subprocess.CalledProcessError, OSError) as exc:
        status["degraded_reason"] = "cannot provision run_as identity: %s" % exc
        write_status(status)
        return None, _stay_up_reporting(status)

    try:
        owner = pwd.getpwnam(WORKSPACE_USER)
        owner_uid, owner_gid = owner.pw_uid, owner.pw_gid
    except KeyError:
        owner_uid, owner_gid = 1000, 1000

    uid, gid = owner_uid, owner_gid
    try:
        if run_as_user or run_as_group:
            record = osh._resolve_user(run_as_user) if run_as_user else None
            if run_as_user:
                uid = record.pw_uid if record else int(run_as_user)
            if run_as_group:
                group = osh._resolve_group(run_as_group)
                gid = group.gr_gid if group else int(run_as_group)
            elif record:
                gid = record.pw_gid
    except (osh.PolicyError, KeyError, ValueError) as exc:
        status["degraded_reason"] = "cannot resolve run_as identity: %s" % exc
        write_status(status)
        return None, _stay_up_reporting(status)

    needs_idmap = uid != owner_uid
    run_as_name = (pwd.getpwuid(uid).pw_name if osh._passwd_has(uid) else str(uid))
    unreachable = check_workdir_access(uid, gid, workdirs)
    if unreachable:
        # A measured failure, so it is worth saying plainly: the agent will start
        # and then be unable to save a file. Reported whether or not an idmap is
        # going to be attempted -- the earlier version suppressed it whenever
        # `needs_idmap` was true, on the assumption the remap would fix it, and a
        # virtiofs share cannot be remapped on this kernel at all.
        status["warnings"].append(
            "run_as uid %d cannot write %s -- the agent will start and then fail "
            "to save files there" % (uid, ", ".join(unreachable)))

    # The home.
    #
    # For a distinct run_as user this is the WORKSPACE user's home, seen through an
    # idmapped mount -- not a home of its own. The reason is function, and it
    # decides the question: Bromure seeds the agent's whole configuration into
    # /home/ubuntu (`~/.claude`, `settings.json`, the `.bashrc` hooks,
    # `.gitconfig`, the agent stubs). A workload with `HOME=/home/sandbox` sees
    # none of it and starts unconfigured, which is a worse workspace than the DAC
    # separation would be worth -- and on a single-tenant workspace VM that
    # separation buys little anyway, since without `run_as_user` the agent runs AS
    # ubuntu and owns all of it. See DESIGN.md §1.12 for what `run_as_user`
    # therefore does and does not mean.
    #
    # But it is only a home if the remap works, and on an image whose /home/ubuntu
    # is virtiofs it cannot. So the remap is PROBED here, with the same code that
    # will perform it, and a home of the run_as user's own on guest storage is the
    # fallback -- chosen here rather than discovered by a pane that cannot write.
    home, run_as_home, home_via = None, None, "passwd entry"
    if needs_idmap:
        owner_home = None
        try:
            owner_home = pwd.getpwuid(owner_uid).pw_dir
        except KeyError:
            pass
        if owner_home and os.path.isdir(owner_home):
            # TWO conditions, and the second is as easy to forget as it is to
            # diagnose: the mount has to be remappable, and the RULESET has to
            # grant it. A home the policy does not cover is a home the workload
            # cannot enter, whatever its ownership says.
            usable, why = policy_grants_write(policy, workdirs, owner_home)
            if usable:
                usable, why = can_idmap(owner_home, owner_uid, uid,
                                        owner_gid, gid)
            if usable:
                home = owner_home
                home_via = "idmapped workspace home"
            else:
                status["warnings"].append(
                    "%s cannot be idmapped (%s), so the workload cannot use it as "
                    "a home and will not see the seeded agent configuration"
                    % (owner_home, why))
        if not home:
            home, home_problem = ensure_run_as_home(uid, gid, run_as_name,
                                                    owner_uid)
            if home_problem:
                status["warnings"].append(home_problem)
            else:
                run_as_home = home
                home_via = "supervisor-created fallback"
    if not home:
        home = pwd.getpwuid(uid).pw_dir if osh._passwd_has(uid) else "/"
        if not os.path.isdir(home):
            home = workdirs[0] if workdirs else "/"

    extra_read_only, extra_read_write, addition_paths = [], [], []
    DYNAMIC_ADDITIONS.clear()
    if policy.filesystem.present:
        for path, _ in ADDITIONS_READ_WRITE:
            if os.path.exists(path):
                extra_read_write.append(path)
                addition_paths.append(path)
        for path, _ in ADDITIONS_READ_ONLY:
            if os.path.exists(path):
                extra_read_only.append(path)
                addition_paths.append(path)
        # DNS. Unconditional, and first, because a workspace whose name
        # resolution is broken looks like a network-policy problem and is the
        # hardest kind of bug to attribute.
        for path, why in resolver_additions():
            if path not in extra_read_only:
                extra_read_only.append(path)
                addition_paths.append(path)
                note_addition(path, why, "ro")
        # OpenShell's own baseline enrichment, on OpenShell's own condition.
        base_ro, base_rw = openshell_baseline_additions(
            spec, policy, workdirs, status)
        for path, why in base_ro:
            if path not in extra_read_only:
                extra_read_only.append(path)
                addition_paths.append(path)
                note_addition(path, why, "ro")
        for path, why in base_rw:
            if path not in extra_read_write:
                extra_read_write.append(path)
                addition_paths.append(path)
                note_addition(path, why, "rw")
        if run_as_home:
            # Bromure plumbing, not something the user's policy has to know
            # about: the workload needs SOME writable home, the supervisor is
            # what provides it, and so the supervisor is what grants it. A
            # workspace whose policy names `run_as_user` therefore needs no
            # change to its `filesystem_policy` at all.
            extra_read_write.append(run_as_home)
            addition_paths.append(run_as_home)
            note_addition(run_as_home,
                          "fallback home for run_as_user %s, created by the "
                          "supervisor because the workspace user's home could "
                          "not be idmapped" % run_as_name, "rw")

    # Resolved HERE, in the parent, so the no-process-layer path can drop
    # privileges after `restrict_self` without touching NSS.
    groups = set([gid, group_gid])
    if osh._passwd_has(uid):
        try:
            groups.update(os.getgrouplist(pwd.getpwuid(uid).pw_name, gid))
        except OSError:
            pass

    status["run_as"] = {
        "uid": uid, "gid": gid, "user": run_as_name, "home": home,
        # MEASURED by fork-and-try, not inferred from the mode bits. True means
        # the workload really can create a file in every workdir, whatever the
        # ownership `stat` reports -- which for a virtiofs share disagrees.
        "workdirs_writable": not unreachable,
        "workdirs_unwritable": unreachable,
        # How the home was arrived at, so the host can say it without the guest
        # having to put an informational line in `warnings` -- which the host
        # weights, and which would then fire on every run_as workspace.
        "home_via": home_via,
    }
    status["seccomp"] = "enforced" if apply_seccomp else "off"
    status["tmux_socket"] = SERVER_SOCKET
    status["control_socket"] = CONTROL_SOCKET
    status["sandbox_cgroup"] = sandbox_cgroup
    status["additions"] = additions_for_report(addition_paths)

    return Plan(policy, workdirs, apply_seccomp, uid, gid,
                status["run_as"]["user"], home, owner_uid, owner_gid,
                needs_idmap, idmap_targets_for(workdirs, owner_uid), group_gid,
                extra_read_only, extra_read_write, addition_paths,
                sandbox_cgroup, sorted(groups)), None


def main():
    if os.geteuid() != 0:
        log("must run as root")
        return 2
    if not os.path.exists(SPEC_PATH):
        log("no %s; nothing to do" % SPEC_PATH)
        return 0

    status = base_status()
    try:
        spec = load_spec()
    except (OSError, ValueError, osh.PolicyError) as exc:
        log("unreadable spec: %s" % exc)
        status["filesystem"] = osh.LandlockOutcome.FAILED
        status["degraded_reason"] = "unreadable spec: %s" % exc
        write_status(status)
        return _stay_up_reporting(status)

    try:
        group_gid = ensure_server_group()
        prepare_directories(group_gid)
    except (subprocess.CalledProcessError, OSError, KeyError) as exc:
        log("cannot prepare the socket layout: %s" % exc)
        status["filesystem"] = osh.LandlockOutcome.FAILED
        status["degraded_reason"] = "cannot prepare the socket layout: %s" % exc
        write_status(status)
        return _stay_up_reporting(status)

    layout_problems = verify_directories(group_gid)
    if layout_problems:
        # The escape analysis at the top of this section depends on the layout.
        # If it is not what we think, refusing is the only safe answer: a
        # workspace with no session beats one whose sandbox can be stepped out of.
        for problem in layout_problems:
            log("LAYOUT: %s" % problem)
        status["filesystem"] = osh.LandlockOutcome.FAILED
        status["degraded_reason"] = ("socket directory layout is unsafe: %s"
                                    % "; ".join(layout_problems))
        write_status(status)
        return _stay_up_reporting(status)

    policy = osh.SandboxPolicy.from_json(spec)
    sandbox_cgroup = prepare_sandbox_cgroup()
    plan, code = build_plan(spec, policy, status, group_gid, sandbox_cgroup)
    if plan is None:
        return code

    # Touch every NSS lookup the confinement path will make, here, before any
    # thread exists. glibc caches the resolver state; the forked child then has
    # nothing cold to initialize while holding a lock it cannot release.
    for warm in (lambda: pwd.getpwuid(plan.uid),
                 lambda: pwd.getpwnam(WORKSPACE_USER),
                 lambda: grp.getgrgid(plan.gid),
                 lambda: grp.getgrnam(SERVER_GROUP)):
        try:
            warm()
        except KeyError:
            pass

    mark_sentry_cgroup(sandbox_cgroup)

    agentd_pid = _agentd_pid()
    supervisor = Supervisor(plan, status, agentd_pid)

    ok, why = supervisor.start("initial")
    if not ok:
        # A hard_requirement that cannot be met surfaces as a PolicyError from
        # osh.prepare inside start_server; anything else lands here. Either way
        # the status says so and agentd refuses to start an unsandboxed session.
        log("initial start failed: %s" % why)
        supervisor.publish()
        if not os.environ.get("BROMURE_SANDBOXD_ONESHOT"):
            # Stay up anyway: agentd may ask again once the host fixes the
            # policy and re-stages the spec, and exiting would have systemd
            # restart-loop us instead.
            supervisor.serve_control()
        return 1

    if os.environ.get("BROMURE_SANDBOXD_ONESHOT"):
        # Test mode: start the server, publish, and exit rather than serving the
        # control socket forever.
        return 0

    supervisor.serve_control()
    return 0

def idmap_targets_for(workdirs, owner_uid):
    """The mounts a distinct `run_as_user` needs remapped.

    The workspace home and the share slots, because those are the virtiofs
    mounts whose ownership comes from the host. Anything else in the policy is
    ordinary guest storage that the guest's own permissions already govern.
    """
    targets = []
    try:
        home = pwd.getpwuid(owner_uid).pw_dir
        if os.path.isdir(home):
            targets.append(home)
    except KeyError:
        pass
    for index in range(1, 9):
        slot = "/mnt/bromure-share-%d" % index
        if os.path.isdir(slot):
            targets.append(slot)
    for path in workdirs:
        if path not in targets and os.path.ismount(path):
            targets.append(path)
    return targets


def _agentd_pid():
    """The supervisor the child filter protects.

    agentd is this program's grandparent through sudo, but reading it from the
    process tree is fragile. `/run/bromure-agentd.pid` is written by agentd; the
    parent chain is the fallback.
    """
    override = os.environ.get("BROMURE_AGENTD_PID")
    if override:
        # Tests need this deterministic; the parent-chain walk below is a
        # heuristic and a test that depends on a heuristic tests the heuristic.
        try:
            return int(override)
        except ValueError:
            pass
    try:
        with open("/run/bromure-agentd.pid") as handle:
            pid = int(handle.read().strip())
        if os.path.isdir("/proc/%d" % pid):
            return pid
    except (OSError, ValueError):
        pass
    pid = os.getppid()
    for _ in range(4):
        try:
            with open("/proc/%d/status" % pid) as handle:
                parent = 0
                name = ""
                for line in handle:
                    if line.startswith("PPid:"):
                        parent = int(line.split()[1])
                    elif line.startswith("Name:"):
                        name = line.split(None, 1)[1].strip()
            if name.startswith("python") and parent > 1:
                return pid
            pid = parent
        except (OSError, ValueError):
            break
    return os.getppid()


def _wait_for_socket(path, timeout):
    deadline = time.time() + timeout
    while time.time() < deadline:
        if os.path.exists(path):
            return True
        time.sleep(0.1)
    return False



if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:  # noqa: BLE001 -- never leave the host without status
        log("fatal: %r" % (exc,))
        try:
            failed = base_status()
            failed["filesystem"] = osh.LandlockOutcome.FAILED
            failed["degraded_reason"] = "sandboxd crashed: %r" % (exc,)
            write_status(failed)
        except OSError:
            pass
        raise
