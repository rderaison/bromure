def load_spec():
    with open(SPEC_PATH) as handle:
        spec = json.load(handle)
    if not isinstance(spec, dict):
        raise osh.PolicyError("openshell-sandbox.json is not an object")
    version = spec.get("version", 1)
    if version != 1:
        raise osh.PolicyError("unsupported spec version %r" % (version,))
    return spec


def resolve_workdirs(spec):
    """What `include_workdir` covers.

    The host stages `workdirs`, which is the better source of truth: it knows
    which project folders this workspace has and where they were mounted. The
    guest can only guess from the share slots, so that is the fallback, not the
    primary. Non-existent entries are dropped here rather than in the Landlock
    layer so the reason is reportable.
    """
    workdirs = [w for w in (spec.get("workdirs") or []) if isinstance(w, str)]
    if workdirs:
        return [w for w in workdirs if os.path.isdir(w)]
    # Fallback: the share slots agentd symlinks into the home directory.
    found = []
    try:
        with open(os.path.join(META, "shares.txt")) as handle:
            for line in handle.read().splitlines():
                parts = line.split(" ", 1)
                if len(parts) == 2 and parts[0]:
                    slot = "/mnt/bromure-share-%s" % parts[0]
                    if os.path.isdir(slot):
                        found.append(slot)
    except OSError:
        pass
    return found


# ---------------------------------------------------------------------------
# run_as_user
# ---------------------------------------------------------------------------

def ensure_user(name):
    """Create the sandbox user if the policy names one that doesn't exist.

    OpenShell errors on an unknown user; its images bake a `sandbox` account.
    Bromure's image has only `ubuntu`, so a policy saying `run_as_user: sandbox`
    would fail on every workspace. Creating it is the difference between "the
    feature works" and "the feature errors", and a fresh system account with no
    shell and no password grants nothing on its own.

    The caller still has to decide whether that uid can reach the workdirs —
    see `check_workdir_access`, and DESIGN.md on virtiofs.
    """
    if name is None or osh._is_numeric(name):
        return
    try:
        pwd.getpwnam(name)
        return
    except KeyError:
        pass
    log("creating sandbox user %r (absent from this image)" % name)
    # A real shell, not nologin: Bromure's workload is interactive panes, and
    # tmux resolves `default-shell` from the running uid's passwd entry when
    # $SHELL is unset. `--no-create-home` stays -- the home is the supervisor's
    # to create, see `ensure_run_as_home` -- and the account still has no
    # password, so nothing can log in as it.
    subprocess.run(
        ["useradd", "--system", "--no-create-home", "--shell", "/bin/bash",
         "--user-group", name],
        check=True, capture_output=True)


def fstype_of(path):
    """The filesystem type of the mount `path` lives on, or None."""
    target = os.path.abspath(path)
    best, fstype = -1, None
    try:
        with open("/proc/self/mountinfo") as handle:
            for line in handle:
                fields = line.split()
                try:
                    mount_point = fields[4]
                    separator = fields.index("-")
                    candidate = fields[separator + 1]
                except (IndexError, ValueError):
                    continue
                mount_point = mount_point.replace("\\040", " ")
                if (target == mount_point or
                        target.startswith(mount_point.rstrip("/") + "/")):
                    if len(mount_point) > best:
                        best, fstype = len(mount_point), candidate
    except OSError:
        return None
    return fstype


# Filesystems whose file ownership comes from the macOS host rather than from
# this guest's passwd file. Nothing here can be chowned, and nothing here can be
# idmapped either -- see `ensure_run_as_home` and DESIGN.md §1.9.
HOST_BACKED_FSTYPES = ("virtiofs", "fuse", "fuseblk", "9p", "nfs", "nfs4")


def ensure_run_as_home(uid, gid, user, owner_uid):
    """A home of the run_as user's own. The FALLBACK. Returns (path, problem).

    The normal home for a distinct `run_as_user` is the workspace user's home seen
    through an idmapped mount -- see `build_plan`, and DESIGN.md §1.12 for why
    function decides that. This is what happens when the remap is impossible,
    which on an image whose `/home/ubuntu` is virtiofs it is.

    It is still needed, because the alternative is worse. `ensure_user` creates the
    account with `--no-create-home`, which leaves `pw_dir` naming a `/home/<user>`
    that does not exist; the supervisor then fell back to the first workdir, and
    both consequences were bad:

      * the workdir on a real workspace is a virtiofs share owned by the macOS
        user, so the workload's `chdir` into its own HOME could fail outright --
        which is precisely how `run_as_user: sandbox` turned every command into a
        silent exit 127, and how the tmux server's `-c <home>` failed the same
        way, leaving the workspace with no session at all;
      * and pointing HOME at the project folder drops the agent's dotfiles,
        history and caches into the user's repository.

    So the run_as user gets `/home/<user>` on the guest's own disk, created here
    because the supervisor is the only thing that is root at the right moment.
    Persistent, which is what makes it a home: the agent's config survives a
    reboot exactly as the workspace user's does. Ownership and mode are
    re-asserted on every start, so a policy that changes `run_as_user` later does
    not leave a home owned by the previous uid.

    **This is why it is not an idmapped `/home/ubuntu` instead.** Idmapping
    cannot do this job on the shipped kernel: virtiofs does not set
    `FS_ALLOW_IDMAP`, so `mount_setattr(MOUNT_ATTR_IDMAP)` returns EINVAL for
    every host-backed mount, measured on 6.8. An idmapped home is not a design
    we rejected; it is one the kernel refuses.
    """
    candidate = None
    try:
        candidate = pwd.getpwuid(uid).pw_dir or None
    except KeyError:
        pass
    # Refuse a pw_dir that is useless or that belongs to somebody else: a
    # `run_as_user` whose passwd entry happens to name /home/ubuntu must not be
    # handed the workspace user's home, and /nonexistent is Debian's placeholder
    # for system accounts.
    owner_home = None
    try:
        owner_home = os.path.realpath(pwd.getpwuid(owner_uid).pw_dir)
    except KeyError:
        pass
    if (not candidate or candidate in ("/", "/nonexistent", "/dev/null")
            or (owner_home and os.path.realpath(candidate) == owner_home)):
        candidate = "/home/%s" % (user if not user.isdigit() else "run-as-%s" % user)

    parent = os.path.dirname(candidate) or "/"
    fstype = fstype_of(parent if not os.path.isdir(candidate) else candidate)
    if fstype in HOST_BACKED_FSTYPES:
        return None, ("cannot give uid %d a home at %s: %s is %s, whose file "
                      "ownership comes from the host and cannot be changed from "
                      "the guest" % (uid, candidate, parent, fstype))
    try:
        os.makedirs(candidate, exist_ok=True)
        os.chown(candidate, uid, gid)
        # 0700: a home, not a shared directory. agentd never reads it; the host
        # never sees it; and the workspace user has no business in the sandbox
        # user's dotfiles any more than the reverse.
        os.chmod(candidate, 0o700)
    except OSError as exc:
        return None, ("cannot create a home for uid %d at %s: %s"
                      % (uid, candidate, exc))
    return candidate, None


def check_workdir_access(uid, gid, workdirs):
    """Can this uid actually WRITE the project folders? Measured, not inferred.

    The first version reasoned from the mode bits, and on the one filesystem that
    matters it reasoned wrongly. Bromure's project folders are virtiofs shares,
    and virtiofs as mounted here does not enforce the guest's DAC in the guest:
    the lookup reports the host's ids, and the operation is carried out by the
    daemon on the host side. Measured on this kernel -- a share that `stat`s as
    `uid 1000 mode 0755` is nonetheless created in, and written to, by uid 999.

    So the mode-bit version produced a prominent, confident, false warning on
    precisely the configuration the whole `run_as_user` feature exists for, and
    would have sent whoever read it looking for a permission problem that was not
    there. There is no way to get this right by inference: the only honest check
    is to become the uid and try.

    Returns the paths that really are unwritable, each with the reason.
    """
    unreachable = []
    for path in workdirs:
        problem = _probe_write_as(uid, gid, path)
        if problem:
            unreachable.append("%s (%s)" % (path, problem))
    return unreachable


def _probe_write_as(uid, gid, path):
    """Create and remove a file in `path` as `uid`. Returns a reason, or None.

    Forked, because the probe has to really be that uid and this process must
    stay root. The name is unique per probe and removed by the child; a child
    that dies in between leaves one empty file, which is a better failure than
    guessing.
    """
    if not os.path.isdir(path):
        return "not a directory"
    probe = os.path.join(path, ".bromure-write-probe-%d" % os.getpid())
    read_fd, write_fd = os.pipe()
    with _FORK_LOCK:
        pid = os.fork()
    if pid == 0:
        os.close(read_fd)
        try:
            os.setgroups([gid])
            os.setresgid(gid, gid, gid)
            os.setresuid(uid, uid, uid)
            fd = os.open(probe, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            os.close(fd)
            os.unlink(probe)
        except OSError as exc:
            _diag_send(write_fd, "%s: %s" % (
                errno.errorcode.get(exc.errno, str(exc.errno)),
                exc.strerror or exc))
            os._exit(1)
        except BaseException as exc:  # noqa: BLE001
            _diag_send(write_fd, str(exc))
            os._exit(1)
        os._exit(0)
    os.close(write_fd)
    try:
        with os.fdopen(read_fd, "rb") as handle:
            message = handle.read().decode("utf-8", "replace").strip()
        os.waitpid(pid, 0)
    except OSError:
        message = "the write probe could not be run"
    if message:
        try:
            os.unlink(probe)
        except OSError:
            pass
        return message
    return None


