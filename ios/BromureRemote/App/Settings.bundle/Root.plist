<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PreferenceSpecifiers</key>
	<array>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Transport</string>
			<key>FooterText</key>
			<string>Experimental. When on, a relay-fallback connection prefers a UDP path (more resilient on slow or lossy links) and drops back to TCP when UDP is blocked. Applies to new connections; the relay server must also have UDP transport enabled.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>UDP relay transport</string>
			<key>Key</key>
			<string>p2p.udpRelay.enabled</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
	</array>
</dict>
</plist>
