// Jenkinsfile.resolv-stub — compile the glibc-compat shim
// (libresolv_stub.so) for arm64/musl in Docker and commit the prebuilt
// binary back to git, mirroring how the out-of-tree kernel modules
// (v4l2loopback, rtc-pl031) ship as committed artifacts instead of being
// built on the end-user's machine.
//
// Why prebuilt-and-committed: warp-cli is a Debian (glibc) binary, and on
// musl Alpine it can't relocate __res_init (gcompat lacks it) or glibc's
// fcntl64. libresolv_stub.so supplies both. The shim is pure userspace
// against musl — kernel-independent — so one arm64 build serves every
// guest kernel, and shipping the committed .so inside the app bundle
// (Resources/vm-setup is .copy'd wholesale) lets the fix reach users
// without a full base-image rebuild or a LinuxImageManager.imageVersion
// bump.
//
//   Source of truth: Sources/SandboxEngine/Resources/vm-setup/configs/resolv-stub.c
//   Output (committed): Sources/SandboxEngine/Resources/vm-setup/resolv-stub/libresolv_stub.so
//
// Runs on the kube-builder-a node (arm64 Docker). It's a no-op commit
// whenever the source hasn't changed, so it's safe to trigger on every
// push to a branch that touches the stub.
pipeline {
    agent { label 'kube-builder-a' }

    options {
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        VM_SETUP = 'Sources/SandboxEngine/Resources/vm-setup'
        STUB     = 'Sources/SandboxEngine/Resources/vm-setup/resolv-stub/libresolv_stub.so'
    }

    stages {
        stage('Docker client') {
            steps {
                // The pod's docker CLI (API 1.42) is older than the DinD daemon
                // accepts (1.44+): "client version 1.42 is too old". Fetch the
                // latest stable static client instead of pinning one; every
                // docker step below puts it first on PATH.
                sh '''
                    set -eu
                    case "$(uname -m)" in
                        aarch64|arm64) arch=aarch64 ;;
                        x86_64|amd64)  arch=x86_64 ;;
                        *) echo "unsupported arch $(uname -m)"; exit 1 ;;
                    esac
                    base="https://download.docker.com/linux/static/stable/$arch"
                    ver=$(curl -fsSL "$base/" | grep -o 'docker-[0-9][0-9.]*\\.tgz' \
                          | sed 's/^docker-//; s/\\.tgz$//' | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)
                    [ -n "$ver" ] || { echo "no docker release found at $base"; exit 1; }
                    rm -rf .docker-cli && mkdir -p .docker-cli
                    curl -fsSL "$base/docker-$ver.tgz" | tar -xz -C .docker-cli --strip-components=1 docker/docker
                    # BuildKit for `docker build` (the static tarball has no plugins);
                    # without it the client falls back to the legacy builder.
                    bx=$(curl -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/docker/buildx/releases/latest | sed 's#.*/tag/##') || bx=""
                    if [ -n "$bx" ]; then
                        mkdir -p .docker-cli/config/cli-plugins
                        bxarch=$([ "$arch" = aarch64 ] && echo arm64 || echo amd64)
                        curl -fsSL -o .docker-cli/config/cli-plugins/docker-buildx \
                            "https://github.com/docker/buildx/releases/download/$bx/buildx-$bx.linux-$bxarch" \
                            && chmod +x .docker-cli/config/cli-plugins/docker-buildx || echo "buildx not installed; legacy builder"
                    fi
                    PATH="$PWD/.docker-cli:$PATH" DOCKER_CONFIG="$PWD/.docker-cli/config" docker version --format 'client {{.Client.Version}} (API {{.Client.APIVersion}}) · daemon {{.Server.Version}} (API {{.Server.APIVersion}})'
                '''
            }
        }

        stage('Build stub in Docker') {
            steps {
                sh '''
                    set -eu
                    export PATH="$WORKSPACE/.docker-cli:$PATH" DOCKER_CONFIG="$WORKSPACE/.docker-cli/config"
                    docker rm -f rstub 2>/dev/null || true
                    docker build --no-cache --platform linux/arm64 \
                        -f "$VM_SETUP/resolv-stub/Dockerfile" \
                        -t resolv-stub-builder "$VM_SETUP"
                    docker create --name rstub resolv-stub-builder
                    docker cp rstub:/out/libresolv_stub.so "$STUB"
                    docker rm rstub
                    ls -l "$STUB"
                '''
            }
        }

        stage('Commit binary') {
            steps {
                // The SCM credential is only bound during Checkout SCM; the
                // push runs in a plain sh step, so bind the same SSH key as a
                // keyfile (the SSH Agent plugin isn't installed, but
                // sshUserPrivateKey from Credentials Binding is). kube-builder-a
                // is an ephemeral pod with no known_hosts, hence accept-new.
                withCredentials([sshUserPrivateKey(
                    credentialsId: '993ae120-54c2-45af-bdd0-2303d982cac7',
                    keyFileVariable: 'SSH_KEY')]) {
                sh '''
                    set -e
                    export GIT_SSH_COMMAND="ssh -i $SSH_KEY -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
                    git config user.name "Renaud Deraison"
                    git config user.email "renaud@secl.io"
                    git add "$STUB"
                    if git diff --cached --quiet; then
                        echo "libresolv_stub.so unchanged — nothing to commit"
                    else
                        git commit -m "sandbox: rebuild libresolv_stub.so (glibc-compat shim)

Prebuilt arm64/musl libresolv_stub.so, compiled in Docker from
configs/resolv-stub.c. Supplies __res_init and forwards glibc's
fcntl64 to musl so the Cloudflare warp-cli binary relocates on
Alpine. Committed like the kernel modules so it ships in the app
bundle without an imageVersion bump.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>"
                        git push origin HEAD:refs/heads/${GIT_BRANCH#*/}
                    fi
                '''
                }
            }
        }
    }

    post {
        always {
            sh '''
                export PATH="$WORKSPACE/.docker-cli:$PATH" DOCKER_CONFIG="$WORKSPACE/.docker-cli/config"
                docker rm -f rstub 2>/dev/null || true
                docker rmi resolv-stub-builder 2>/dev/null || true
            '''
        }
    }
}
