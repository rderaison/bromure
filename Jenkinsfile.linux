// Jenkinsfile.linux — the Linux multi-user server (Bromure Agentic Coding on
// Firecracker) as Debian packages: bromure-ac-<version>_amd64.deb and
// bromure-ac-<version>_arm64.deb, each archived with its SHA-256.
//
// The builder is kube-builder-b (arm64 Docker-in-Docker, no bind mounts:
// inputs go in with `docker build`, results come out with `docker cp`):
// arm64 is a native build, amd64 a cross build. Nothing runs under
// emulation. For each architecture, one after the other:
//   1. Toolchain image (linux/packaging/Dockerfile.toolchain), for the
//      builder's platform: Swift, Rust and, for amd64, a Swift SDK for
//      x86_64-unknown-linux-gnu made by swift-sdk-generator (with zlib and
//      libbrotlidec added to its sysroot), and for Firecracker Ubuntu's
//      x86_64 cross gcc with multiarch musl and the amd64 kernel headers.
//   2. Build container: the source (`git archive HEAD`) on that image,
//      linux/packaging/build-deb.sh: `swift build --swift-sdk`, the Swift
//      runtime it links, Firecracker (static musl), the PII model, the
//      resources, the units, the maintainer scripts, `dpkg-deb`.
//   3. Archive: the .deb and its .sha256 (and a dpkg-deb listing in the log).
//   4. PUSH_RELEASE: publish them to the APT repository on DigitalOcean
//      Spaces, https://dl.bromure.io/apt, suite RELEASE_CHANNEL (stable or
//      beta), with tools/apt-publish.mjs in a node container; then apt
//      itself reads the repository back through dl.bromure.io.
//
// The guest image isn't built here (it is baked for the server's KVM, or
// downloaded: `bromure-image-install` after the install).
pipeline {
    agent { label 'kube-builder-b' }

    options {
        // A cold toolchain image (SDK generation, Rust toolchain) plus a
        // release build: ~40-60 min; a warm daemon cache, ~20.
        timeout(time: 2, unit: 'HOURS')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '10'))
    }

    // A blank parameter (or any on the run that first registers them) isn't
    // set in the environment at all, and the steps run under `set -u`: each
    // one is read with its default.
    parameters {
        choice(name: 'TARGET_ARCHES', choices: ['both', 'x86_64', 'aarch64'],
            description: 'The packages to build: both, or one (x86_64 = amd64, cross-built on the arm64 builder; aarch64 = arm64, native).')
        string(name: 'SWIFT_IMAGE', defaultValue: 'swift:6.4-noble',
            description: 'The Swift image the toolchain is built on (its Swift version is the SDK\'s).')
        booleanParam(name: 'PUSH_RELEASE', defaultValue: false,
            description: 'Publish the packages to the APT repository on DigitalOcean Spaces (https://dl.bromure.io/apt).')
        choice(name: 'RELEASE_CHANNEL', choices: ['stable', 'beta'],
            description: 'The APT suite they go to. Only used when PUSH_RELEASE is checked. A version already in the other suite is promoted: this suite gets that package, not this build\'s.')
    }

    environment {
        // Non-secret Spaces config (as Jenkinsfile.ac). The secrets are
        // Jenkins credentials: DO_SPACES_KEY, DO_SPACES_SECRET, and
        // APT_SIGNING_KEY (a secret file: the armored OpenPGP secret key,
        // without a passphrase, that signs the repository).
        DO_SPACES_ENDPOINT    = 'https://nyc3.digitaloceanspaces.com'
        DO_SPACES_REGION      = 'nyc3'
        DO_SPACES_BUCKET      = 'bromure-dl'
        DO_SPACES_PUBLIC_BASE = 'https://dl.bromure.io'
    }

    stages {
        stage('Docker client') {
            steps {
                // The pod's docker CLI (API 1.42) is older than the DinD daemon
                // accepts (1.44+): fetch the latest stable static client, and
                // BuildKit's buildx plugin (as Jenkinsfile.sentry).
                sh '''
                    set -eu
                    case "$(uname -m)" in
                        aarch64|arm64) arch=aarch64 ;;
                        x86_64|amd64)  arch=x86_64 ;;
                        *) echo "unsupported arch $(uname -m)"; exit 1 ;;
                    esac
                    base="https://download.docker.com/linux/static/stable/$arch"
                    ver=$(curl -fsSL "$base/" | grep -o 'docker-[0-9][0-9.]*\\.tgz' \
                          | sed 's/^docker-//; s/\\.tgz$//' | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)
                    [ -n "$ver" ] || { echo "no docker release found at $base"; exit 1; }
                    rm -rf .docker-cli && mkdir -p .docker-cli
                    curl -fsSL "$base/docker-$ver.tgz" | tar -xz -C .docker-cli --strip-components=1 docker/docker
                    bx=$(curl -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/docker/buildx/releases/latest | sed 's#.*/tag/##') || bx=""
                    if [ -n "$bx" ]; then
                        mkdir -p .docker-cli/config/cli-plugins
                        bxarch=$([ "$arch" = aarch64 ] && echo arm64 || echo amd64)
                        curl -fsSL -o .docker-cli/config/cli-plugins/docker-buildx \
                            "https://github.com/docker/buildx/releases/download/$bx/buildx-$bx.linux-$bxarch" \
                            && chmod +x .docker-cli/config/cli-plugins/docker-buildx || echo "buildx not installed; legacy builder"
                    fi
                    PATH="$PWD/.docker-cli:$PATH" DOCKER_CONFIG="$PWD/.docker-cli/config" docker version --format 'client {{.Client.Version}} · daemon {{.Server.Version}}'
                '''
            }
        }

        stage('Version') {
            steps {
                // The package is versioned LinuxAppVersion.short; `git describe`
                // and the commit go in its build info, and the source goes in
                // without .git: the tags first (the SCM
                // credential is only bound during Checkout SCM; kube-builder-b
                // is an ephemeral pod with no known_hosts, hence accept-new).
                withCredentials([sshUserPrivateKey(
                    credentialsId: '993ae120-54c2-45af-bdd0-2303d982cac7',
                    keyFileVariable: 'SSH_KEY')]) {
                    sh '''
                        set -eu
                        export GIT_SSH_COMMAND="ssh -i $SSH_KEY -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
                        git fetch --tags --force --quiet origin || echo "WARNING: tags not fetched; the version falls back to the commit"
                    '''
                }
                sh '''
                    set -eu
                    rm -rf deb-ci && mkdir -p deb-ci
                    case "${TARGET_ARCHES:-both}" in
                        both) echo "x86_64 aarch64" ;;
                        x86_64|aarch64) echo "$TARGET_ARCHES" ;;
                        *) echo "bad TARGET_ARCHES '$TARGET_ARCHES'"; exit 1 ;;
                    esac > deb-ci/arches
                    echo "architectures: $(cat deb-ci/arches)"
                    v=$(git describe --tags --always --match 'agentic-coding-v*')
                    c=$(git rev-parse --short=8 HEAD)
                    printf 'BROMURE_BUILD_VERSION=%s\\nBROMURE_BUILD_COMMIT=%s\\n' "$v" "$c" > deb-ci/version.env
                    cat deb-ci/version.env
                '''
            }
        }

        stage('Toolchain image') {
            steps {
                // One per target, its own tag per (Swift image, target,
                // Dockerfile): a daemon that kept the layers reuses them.
                sh '''
                    set -eu
                    export PATH="$WORKSPACE/.docker-cli:$PATH" DOCKER_CONFIG="$WORKSPACE/.docker-cli/config"
                    swift_image="${SWIFT_IMAGE:-swift:6.4-noble}"
                    mkdir -p deb-ci/toolchain-ctx
                    cp linux/packaging/Dockerfile.toolchain deb-ci/toolchain-ctx/Dockerfile
                    for arch in $(cat deb-ci/arches); do
                        key=$( { echo "$swift_image $arch"; cat linux/packaging/Dockerfile.toolchain; } | sha256sum | cut -c1-12)
                        tag="bromure-linux-toolchain:$arch-$key"
                        echo "$tag" > "deb-ci/toolchain-tag-$arch"
                        echo "=== toolchain $tag"
                        docker build --pull -t "$tag" \
                            --build-arg SWIFT_IMAGE="$swift_image" \
                            --build-arg TARGET_ARCH="$arch" \
                            deb-ci/toolchain-ctx
                    done
                '''
            }
        }

        stage('Build package') {
            steps {
                sh '''
                    set -eu
                    export PATH="$WORKSPACE/.docker-cli:$PATH" DOCKER_CONFIG="$WORKSPACE/.docker-cli/config"
                    # The committed tree only: no workspace leftovers in the package.
                    mkdir -p deb-ci/src deb-ci/out
                    git archive --format=tar HEAD | tar -x -C deb-ci/src
                    for arch in $(cat deb-ci/arches); do
                        echo "=== bromure-ac for $arch"
                        name="bromure-deb-$BUILD_NUMBER-$arch"
                        ctx="deb-ci/ctx-$arch"
                        mkdir -p "$ctx"
                        cp -a deb-ci/src "$ctx/src"
                        cp deb-ci/version.env "$ctx/version.env"
                        printf 'FROM %s\\nCOPY src /src\\nCOPY version.env /version.env\\nWORKDIR /src\\n' "$(cat "deb-ci/toolchain-tag-$arch")" > "$ctx/Dockerfile"
                        docker build -q -t "bromure-deb-src:$BUILD_NUMBER-$arch" "$ctx"
                        docker rm -f "$name" 2>/dev/null || true
                        docker run --name "$name" \
                            -e TARGET_ARCH="$arch" -e BUILD_NUMBER="$BUILD_NUMBER" \
                            "bromure-deb-src:$BUILD_NUMBER-$arch" \
                            bash -c 'set -a; . /version.env; set +a; linux/packaging/build-deb.sh /out'
                        rm -rf "deb-ci/out-$arch"
                        docker cp "$name:/out" "deb-ci/out-$arch"
                        docker rm "$name"
                        docker rmi "bromure-deb-src:$BUILD_NUMBER-$arch" >/dev/null || true
                        rm -rf "$ctx"
                        cp "deb-ci/out-$arch"/* deb-ci/out/
                    done
                    ls -l deb-ci/out
                    (cd deb-ci/out && sha256sum -c ./*.sha256)
                '''
            }
        }

        stage('Publish (APT)') {
            when { expression { return params.PUSH_RELEASE } }
            steps {
                withCredentials([
                    string(credentialsId: 'DO_SPACES_KEY',    variable: 'DO_SPACES_KEY'),
                    string(credentialsId: 'DO_SPACES_SECRET', variable: 'DO_SPACES_SECRET'),
                    file(credentialsId:   'APT_SIGNING_KEY',  variable: 'APT_KEY_FILE')
                ]) {
                    sh '''
                        set -eu
                        export PATH="$WORKSPACE/.docker-cli:$PATH" DOCKER_CONFIG="$WORKSPACE/.docker-cli/config"
                        suite="${RELEASE_CHANNEL:-stable}"
                        # The publisher image: node, the release tools (socket.dev-
                        # wrapped install, like the other pipelines), dpkg-deb, gpg
                        # and apt (Debian's), and this run's packages.
                        rm -rf deb-ci/pub && mkdir -p deb-ci/pub/tools deb-ci/pub/debs
                        cp tools/package.json tools/package-lock.json tools/apt-publish.mjs deb-ci/pub/tools/
                        cp deb-ci/out/*.deb deb-ci/pub/debs/
                        printf '%s\\n' \\
                            'FROM node:22-bookworm-slim' \\
                            'RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends gnupg curl ca-certificates && rm -rf /var/lib/apt/lists/*' \\
                            'WORKDIR /work' \\
                            'COPY tools/package.json tools/package-lock.json tools/' \\
                            'RUN cd tools && (npx --yes @socketsecurity/cli npm ci --silent || npx --yes @socketsecurity/cli npm install --silent)' \\
                            'COPY . .' > deb-ci/pub/Dockerfile
                        docker build -q -t "bromure-apt-publisher:$BUILD_NUMBER" deb-ci/pub
                        # The key goes in as an environment variable (no bind mounts here).
                        APT_SIGNING_KEY=$(cat "$APT_KEY_FILE")
                        export APT_SIGNING_KEY
                        docker run --rm \\
                            -e DO_SPACES_KEY -e DO_SPACES_SECRET -e APT_SIGNING_KEY \\
                            -e DO_SPACES_ENDPOINT -e DO_SPACES_REGION -e DO_SPACES_BUCKET -e DO_SPACES_PUBLIC_BASE \\
                            "bromure-apt-publisher:$BUILD_NUMBER" \\
                            sh -c 'node tools/apt-publish.mjs publish --suite "$0" debs/*.deb' "$suite"
                        unset APT_SIGNING_KEY

                        # Read back as a server would, through dl.bromure.io: the
                        # version this run built, for the architectures it built.
                        version=$(ls deb-ci/out/*.deb | head -1 | sed 's#.*/bromure-ac-##; s#_[^_]*[.]deb$##')
                        arches=$(sed 's/x86_64/amd64/; s/aarch64/arm64/; s/ /,/g' deb-ci/arches)
                        ok=0
                        for attempt in 1 2 3 4 5 6 7 8; do
                            if docker run --rm "bromure-apt-publisher:$BUILD_NUMBER" \\
                                node tools/apt-publish.mjs verify --url "$DO_SPACES_PUBLIC_BASE/apt" \\
                                    --suite "$suite" --expect "$version" --arches "$arches"; then
                                ok=1; break
                            fi
                            echo "not visible yet (attempt $attempt); retrying in 15 s"
                            sleep 15
                        done
                        docker rmi "bromure-apt-publisher:$BUILD_NUMBER" >/dev/null || true
                        [ "$ok" = 1 ] || { echo "the published repository doesn't read back as $version ($arches) in $suite"; exit 1; }
                        echo
                        echo "bromure-ac $version is in $suite. On a server:"
                        echo "  sudo install -d -m 755 /etc/apt/keyrings"
                        echo "  curl -fsSL $DO_SPACES_PUBLIC_BASE/apt/bromure-archive-keyring.gpg | sudo tee /etc/apt/keyrings/bromure.gpg >/dev/null"
                        echo "  echo 'deb [signed-by=/etc/apt/keyrings/bromure.gpg] $DO_SPACES_PUBLIC_BASE/apt $suite main' | sudo tee /etc/apt/sources.list.d/bromure.list"
                        echo "  sudo apt update && sudo apt install bromure-ac"
                    '''
                }
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'deb-ci/out/*.deb, deb-ci/out/*.sha256', fingerprint: true
        }
        always {
            sh '''
                export PATH="$WORKSPACE/.docker-cli:$PATH" DOCKER_CONFIG="$WORKSPACE/.docker-cli/config"
                for arch in x86_64 aarch64; do docker rm -f "bromure-deb-$BUILD_NUMBER-$arch" >/dev/null 2>&1 || true; done
            '''
        }
    }
}
