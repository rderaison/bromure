// Jenkinsfile.client-linux — build the Bromure Client (web-client/, the
// Electron app) for Linux, x64 and arm64, and check the packages install and
// launch on clean distros.
//
// Everything runs in containers (kube-builder-a is Docker-in-Docker, so no
// bind mounts: inputs go in via `docker build`, results out via `docker cp`,
// as in Jenkinsfile.sentry):
//   1. Build (web-client/ci/linux/Dockerfile, BuildKit): the network tunnel's
//      Go program (vet, tests, both arches), then in node:22 socket.dev-wrapped
//      npm ci, typecheck, unit tests, vite + esbuild builds, then
//      scripts/package.mjs for every arch in ARCHES — both from one container
//      on either host arch (packaging only swaps Electron's prebuilt binary).
//      ci/linux/build.sh checks each .deb (arch, setuid chrome-sandbox,
//      desktop entry + bromure-client:// handler, Electron's ELF arch) and
//      tarball, and writes SHA256SUMS.
//   2. Smoke, each arch natively: the .deb apt-installed on clean
//      SMOKE_BASES images (its Depends must resolve), the install checked,
//      the app rendered headless under Xvfb (ci/linux/smoke-host.sh). arm64
//      on kube-builder-a; amd64 on linux-kvm-amd64 (inputs and outputs by
//      stash), where a busy or failing agent only marks the run UNSTABLE.
//   3. PUSH_RELEASE (and only when everything above passed): publish the
//      .debs to the APT repository on DigitalOcean Spaces — the same one as
//      bromure-ac (Jenkinsfile.linux), https://dl.bromure.io/apt, suite
//      RELEASE_CHANNEL, signed with the same APT_SIGNING_KEY — with
//      tools/apt-publish.mjs --package bromure-client in a node container;
//      then apt itself reads the repository back through dl.bromure.io.
//      A version already in the suite is refused: bump web-client/package.json.
//   4. Archive: out/*.deb, out/*.tar.gz, SHA256SUMS and the smoke renders.
pipeline {
    agent { label 'kube-builder-a' }

    options {
        // Build ~5 min, packaging downloads Electron per arch, each smoke
        // image is an apt install of a desktop stack: anything past 1h is wedged.
        timeout(time: 1, unit: 'HOURS')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '10'))
    }

    // A blank string parameter (or any parameter on the run that first
    // registers them) isn't set in the environment at all, and the steps run
    // under `set -u`: each one is read with its default.
    parameters {
        string(name: 'ARCHES', defaultValue: 'x64,arm64',
            description: 'Linux arches to package (comma-separated: x64, arm64).')
        string(name: 'SMOKE_BASES', defaultValue: 'ubuntu:24.04 debian:12',
            description: 'Distro images the .deb is installed and launched on (space-separated).')
        booleanParam(name: 'SMOKE_AMD64', defaultValue: true,
            description: 'Also smoke-test the amd64 .deb natively on linux-kvm-amd64.')
        booleanParam(name: 'PUSH_RELEASE', defaultValue: false,
            description: 'Publish the .debs to the APT repository on DigitalOcean Spaces (https://dl.bromure.io/apt). Skipped unless the build and every smoke passed.')
        choice(name: 'RELEASE_CHANNEL', choices: ['stable', 'beta'],
            description: 'The APT suite they go to. Only used when PUSH_RELEASE is checked. A version already in the other suite is promoted: this suite gets that package, not this build\'s.')
    }

    environment {
        // Non-secret Spaces config, as Jenkinsfile.linux (bromure-ac): the
        // same repository. The secrets are Jenkins credentials: DO_SPACES_KEY,
        // DO_SPACES_SECRET, and APT_SIGNING_KEY (a secret file: the armored
        // OpenPGP secret key, without a passphrase, that signs the repository).
        DO_SPACES_ENDPOINT    = 'https://nyc3.digitaloceanspaces.com'
        DO_SPACES_REGION      = 'nyc3'
        DO_SPACES_BUCKET      = 'bromure-dl'
        DO_SPACES_PUBLIC_BASE = 'https://dl.bromure.io'
    }

    stages {
        stage('Docker client') {
            steps {
                // The pod's docker CLI (API 1.42) is older than the DinD daemon
                // accepts (1.44+): fetch the latest stable static client (same
                // as Jenkinsfile.sentry); every docker step puts it first on PATH.
                sh '''
                    set -eu
                    case "$(uname -m)" in
                        aarch64|arm64) arch=aarch64 ;;
                        x86_64|amd64)  arch=x86_64 ;;
                        *) echo "unsupported arch $(uname -m)"; exit 1 ;;
                    esac
                    base="https://download.docker.com/linux/static/stable/$arch"
                    ver=$(curl -fsSL "$base/" | grep -o 'docker-[0-9][0-9.]*\\.tgz' \
                          | sed 's/^docker-//; s/\\.tgz$//' | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)
                    [ -n "$ver" ] || { echo "no docker release found at $base"; exit 1; }
                    rm -rf .docker-cli && mkdir -p .docker-cli
                    curl -fsSL "$base/docker-$ver.tgz" | tar -xz -C .docker-cli --strip-components=1 docker/docker
                    bx=$(curl -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/docker/buildx/releases/latest | sed 's#.*/tag/##') || bx=""
                    if [ -n "$bx" ]; then
                        mkdir -p .docker-cli/config/cli-plugins
                        bxarch=$([ "$arch" = aarch64 ] && echo arm64 || echo amd64)
                        curl -fsSL -o .docker-cli/config/cli-plugins/docker-buildx \
                            "https://github.com/docker/buildx/releases/download/$bx/buildx-$bx.linux-$bxarch" \
                            && chmod +x .docker-cli/config/cli-plugins/docker-buildx || bx=""
                    fi
                    # BuildKit is required: ci/linux/Dockerfile's Go stage is
                    # FROM --platform=$BUILDPLATFORM (the legacy builder can't).
                    [ -n "$bx" ] || { echo "couldn't install docker buildx"; exit 1; }
                    PATH="$PWD/.docker-cli:$PATH" DOCKER_CONFIG="$PWD/.docker-cli/config" docker version --format 'client {{.Client.Version}} (API {{.Client.APIVersion}}) · daemon {{.Server.Version}} (API {{.Server.APIVersion}})'
                '''
            }
        }

        stage('Build') {
            steps {
                sh '''
                    set -eu
                    export PATH="$WORKSPACE/.docker-cli:$PATH" DOCKER_CONFIG="$WORKSPACE/.docker-cli/config"
                    c="bcl-build-$BUILD_NUMBER"
                    img="bromure-client-linux-builder:$BUILD_NUMBER"
                    docker rm -f "$c" 2>/dev/null || true
                    docker buildx build --load --pull -t "$img" -f web-client/ci/linux/Dockerfile web-client
                    docker run --name "$c" -e ARCHES="${ARCHES:-x64,arm64}" "$img"
                    rm -rf client-linux && mkdir -p client-linux
                    docker cp "$c:/home/node/artifacts/." client-linux/
                    docker rm "$c"
                    ls -l client-linux
                '''
                script {
                    env.HOST_ARCH = sh(script: 'uname -m', returnStdout: true).trim()
                }
                // The amd64 smoke runs on another agent: it takes the .deb and
                // the smoke files.
                stash name: 'client-linux-amd64',
                      includes: 'client-linux/*_amd64.deb, web-client/ci/linux/smoke-host.sh, web-client/ci/linux/smoke.sh, web-client/ci/linux/Dockerfile.smoke',
                      allowEmpty: true
            }
        }

        stage('Smoke') {
            parallel {
                stage('this agent') {
                    steps {
                        sh '''
                            set -eu
                            export PATH="$WORKSPACE/.docker-cli:$PATH" DOCKER_CONFIG="$WORKSPACE/.docker-cli/config"
                            export SMOKE_BASES="${SMOKE_BASES:-ubuntu:24.04 debian:12}"
                            sh web-client/ci/linux/smoke-host.sh client-linux client-linux/smoke
                        '''
                    }
                }
                // Natively on the x86_64 agent. Not a stage-level agent: it
                // also runs long jobs, and a stage that times out waiting for
                // it would fail the run; here a busy, offline or failing amd64
                // side only marks the run UNSTABLE.
                stage('amd64') {
                    when {
                        expression {
                            params.SMOKE_AMD64 != false && env.HOST_ARCH != 'x86_64' &&
                                (params.ARCHES ?: 'x64,arm64').split(',').collect { it.trim() }.contains('x64')
                        }
                    }
                    steps {
                        script {
                            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                                timeout(time: 40, unit: 'MINUTES') {
                                    node('linux-kvm-amd64') {
                                        try {
                                            sh 'rm -rf client-linux web-client'
                                            unstash 'client-linux-amd64'
                                            sh '''
                                                set -eu
                                                [ "$(uname -m)" = x86_64 ] || { echo "the amd64 smoke runs natively: an x86_64 agent, not $(uname -m)"; exit 1; }
                                                export SMOKE_BASES="${SMOKE_BASES:-ubuntu:24.04 debian:12}"
                                                sh web-client/ci/linux/smoke-host.sh client-linux client-linux/smoke
                                            '''
                                        } finally {
                                            stash name: 'client-linux-amd64-smoke', includes: 'client-linux/smoke/**', allowEmpty: true
                                            sh '''
                                                for c in $(docker ps -aq --filter name=bcl-smoke-); do docker rm -f "$c"; done 2>/dev/null || true
                                                rm -rf client-linux web-client
                                            '''
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        stage('Publish (APT)') {
            // Never a package whose smoke failed (an UNSTABLE amd64 side included).
            when { expression { params.PUSH_RELEASE == true && currentBuild.currentResult == 'SUCCESS' } }
            steps {
                withCredentials([
                    string(credentialsId: 'DO_SPACES_KEY',    variable: 'DO_SPACES_KEY'),
                    string(credentialsId: 'DO_SPACES_SECRET', variable: 'DO_SPACES_SECRET'),
                    file(credentialsId:   'APT_SIGNING_KEY',  variable: 'APT_KEY_FILE')
                ]) {
                    sh '''
                        set -eu
                        export PATH="$WORKSPACE/.docker-cli:$PATH" DOCKER_CONFIG="$WORKSPACE/.docker-cli/config"
                        suite="${RELEASE_CHANNEL:-stable}"
                        ls client-linux/bromure-client_*.deb >/dev/null 2>&1 || { echo "no .deb to publish"; exit 1; }
                        # The publisher image (as Jenkinsfile.linux): node, the release
                        # tools (socket.dev-wrapped install), gpg, dpkg-deb and apt
                        # (Debian's), and this run's packages.
                        rm -rf client-linux/pub && mkdir -p client-linux/pub/tools client-linux/pub/debs
                        cp tools/package.json tools/package-lock.json tools/apt-publish.mjs client-linux/pub/tools/
                        cp client-linux/bromure-client_*.deb client-linux/pub/debs/
                        printf '%s\\n' \\
                            'FROM node:22-bookworm-slim' \\
                            'RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends gnupg curl ca-certificates && rm -rf /var/lib/apt/lists/*' \\
                            'WORKDIR /work' \\
                            'COPY tools/package.json tools/package-lock.json tools/' \\
                            'RUN cd tools && (npx --yes @socketsecurity/cli npm ci --silent || npx --yes @socketsecurity/cli npm install --silent)' \\
                            'COPY . .' > client-linux/pub/Dockerfile
                        img="bromure-client-apt-publisher:$BUILD_NUMBER"
                        docker build -q -t "$img" client-linux/pub
                        # The key goes in as an environment variable (no bind mounts here).
                        APT_SIGNING_KEY=$(cat "$APT_KEY_FILE")
                        export APT_SIGNING_KEY
                        docker run --rm \\
                            -e DO_SPACES_KEY -e DO_SPACES_SECRET -e APT_SIGNING_KEY \\
                            -e DO_SPACES_ENDPOINT -e DO_SPACES_REGION -e DO_SPACES_BUCKET -e DO_SPACES_PUBLIC_BASE \\
                            "$img" \\
                            sh -c 'node tools/apt-publish.mjs publish --package bromure-client --suite "$0" debs/*.deb' "$suite"
                        unset APT_SIGNING_KEY

                        # Read back as a desktop would, through dl.bromure.io: the
                        # version this run built, for the architectures it built.
                        version=$(ls client-linux/bromure-client_*.deb | head -1 | sed 's#.*/bromure-client_##; s#_[^_]*[.]deb$##')
                        arches=$(ls client-linux/bromure-client_*.deb | sed 's#.*_##; s#[.]deb$##' | sort -u | paste -sd, -)
                        ok=0
                        for attempt in 1 2 3 4 5 6 7 8; do
                            if docker run --rm "$img" \\
                                node tools/apt-publish.mjs verify --package bromure-client --url "$DO_SPACES_PUBLIC_BASE/apt" \\
                                    --suite "$suite" --expect "$version" --arches "$arches"; then
                                ok=1; break
                            fi
                            echo "not visible yet (attempt $attempt); retrying in 15 s"
                            sleep 15
                        done
                        docker rmi "$img" >/dev/null || true
                        [ "$ok" = 1 ] || { echo "the published repository doesn't read back as $version ($arches) in $suite"; exit 1; }
                        echo
                        echo "bromure-client $version is in $suite. On a desktop:"
                        echo "  sudo install -d -m 755 /etc/apt/keyrings"
                        echo "  curl -fsSL $DO_SPACES_PUBLIC_BASE/apt/bromure-archive-keyring.gpg | sudo tee /etc/apt/keyrings/bromure.gpg >/dev/null"
                        echo "  echo 'deb [signed-by=/etc/apt/keyrings/bromure.gpg] $DO_SPACES_PUBLIC_BASE/apt $suite main' | sudo tee /etc/apt/sources.list.d/bromure.list"
                        echo "  sudo apt update && sudo apt install bromure-client"
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                try { unstash 'client-linux-amd64-smoke' } catch (e) { echo "No amd64 smoke results: ${e.message}" }
            }
            archiveArtifacts artifacts: 'client-linux/*.deb, client-linux/*.tar.gz, client-linux/SHA256SUMS',
                             fingerprint: true, allowEmptyArchive: true
            archiveArtifacts artifacts: 'client-linux/smoke/**', allowEmptyArchive: true
            sh '''
                export PATH="$WORKSPACE/.docker-cli:$PATH" DOCKER_CONFIG="$WORKSPACE/.docker-cli/config"
                for c in $(docker ps -aq --filter name=bcl-); do docker rm -f "$c"; done 2>/dev/null || true
                docker image rm -f "bromure-client-linux-builder:$BUILD_NUMBER" 2>/dev/null || true
            '''
        }
    }
}
