{
  "name": "bromure-client-web",
  "private": true,
  "version": "0.1.0",
  "description": "Bromure Agentic Coding client \u2014 web (hosted on bromure.io) and Electron (Linux/Windows)",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:relay": "node scripts/dev-relay.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:electron": "node electron/build.mjs",
    "build:web": "tsc -p tsconfig.json --noEmit && vite build --base=/client/ --outDir dist-web",
    "build:hosted": "npm run build:web && COPYFILE_DISABLE=1 tar --no-xattrs --exclude=*.map -czf bromure-client-web.tgz -C dist-web .",
    "electron": "npm run build && npm run build:electron && electron .",
    "package:linux": "npm run build && npm run build:electron && node scripts/package.mjs linux",
    "package:win": "npm run build && npm run build:electron && node scripts/package.mjs win32",
    "installer:win": "node scripts/installer-win.mjs",
    "make:icon": "electron scripts/make-icon.cjs",
    "test": "vitest run",
    "test:tunnel": "cd tunnel && go test ./...",
    "check:icons": "node scripts/check-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "ws": "^8.23.0"
  },
  "productName": "Bromure Client",
  "desktopName": "io.bromure.client.desktop"
}
