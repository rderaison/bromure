Package.resolved
# Except the iOS app's: the TestFlight archive runs package plug-ins without a
# trust prompt, so it builds only these reviewed pins
# (scripts/verify-ios-packages.py).
!ios/BromureRemote/BromureRemote.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
*.provisionprofile
Tests/node_modules/
.claude/dev/

# GhosttyKit build products (tools/build-ghostty.sh output — never committed).
# Anchored to the repo root: unanchored `vendor/` also swallowed
# Sources/AgentCoding/Vendor/ (vendored source that IS committed).
# No trailing slash: `/vendor/` matched only a directory, so a dev setup
# where vendor is a SYMLINK (e.g. into a shared worktree) wasn't ignored —
# that's how a dangling absolute symlink got committed and broke fresh CI
# checkouts once.
/vendor

# Generated, regenerable manual artifacts (the MDX source under manual/ is
# tracked; the rendered site and the packaged tarball are not).
manual/_site/
bromure-agentic-coding-manual.tgz
.build-ios/
